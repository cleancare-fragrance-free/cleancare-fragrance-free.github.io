---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import { learningVideos } from '../data/learning-videos.mjs';
import { url } from '../lib/paths';
const publications = [
  { type: 'Health education · American Lung Association', title: 'Fragrances and indoor air', href: 'https://www.lung.org/clean-air/indoor-air/indoor-air-pollutants/fragrances', supports: 'Explains indoor-air sources, symptoms reported by some people, groups that may be more sensitive, and practical exposure-reduction steps.' },
  { type: 'Government guidance · FDA', title: 'Fragrances in Cosmetics', href: 'https://www.fda.gov/cosmetics/cosmetic-ingredients/fragrances-cosmetics', supports: 'Explains US cosmetic labeling, fragrance mixtures, and sensitivity. It does not say every fragrance is harmful.' },
  { type: 'Government guidance · FDA', title: 'Allergens in Cosmetics', href: 'https://www.fda.gov/cosmetics/cosmetic-ingredients/allergens-cosmetics', supports: 'Documents fragrance as a possible cosmetic allergen and explains label limitations.' },
  { type: 'Government guidance · EPA', title: 'VOCs and Indoor Air Quality', href: 'https://www.epa.gov/indoor-air-quality-iaq/volatile-organic-compounds-impact-indoor-air-quality', supports: 'Describes VOC sources, possible effects, and source-control steps. VOCs are a broad group, not one risk level.' },
  { type: 'Primary research · Population study', title: 'Fragrance contact allergy in five European countries', href: 'https://pubmed.ncbi.nlm.nih.gov/26332456/', supports: 'Reports patch-test results in a sampled European adult population. Its prevalence estimate is not universal.' },
  { type: 'Primary research · Chamber experiment', title: 'Ozone and limonene in indoor air', href: 'https://pubmed.ncbi.nlm.nih.gov/11133393/', supports: 'Measured particle formation after ozone reacted with limonene under controlled conditions. It did not measure clinical effects.' },
  { type: 'Primary research · Chamber experiment', title: 'Ozone-initiated emissions from a cleaner and air freshener', href: 'https://pubmed.ncbi.nlm.nih.gov/24769411/', supports: 'Measured emissions and reaction products from two products at tested ozone levels; results cannot represent every home.' },
  { type: 'Government context · EPA', title: 'Can fragrances indoors cause health impacts?', href: 'https://www.epa.gov/asthma/can-use-fragrances-indoors-cause-health-impacts', supports: 'Acknowledges effects in some sensitive people and uncertainty about the causes of some reported reactions.' },
  { type: 'Government publication · EPA', title: 'If it smells good and fresh, is it good for my indoor air and me?', href: 'https://www.epa.gov/sites/default/files/2015-09/documents/view_indoors_odors.pdf', supports: 'Explains why odor alone is not a safety test and offers practical steps for shared indoor spaces.' },
  { type: 'Government criteria · EPA', title: 'Safer Choice Fragrance-Free criteria', href: 'https://www.epa.gov/saferchoice/safer-choice-criteria-fragrance-free-products', supports: 'Shows how a specific US certification checks products for fragrance materials. It is not a universal product claim.' },
  { type: 'University research report · Purdue', title: 'Everyday scented products and indoor nanoparticles', href: 'https://www.purdue.edu/newsroom/2025/Q1/air-inside-your-home-may-be-more-polluted-than-outside-due-to-everyday-chemical-products/', supports: 'Summarises Purdue measurements and links to the primary papers. Particle formation was measured; long-term clinical effects still require toxicology research.' },
];
---
<Layout title="Evidence library | Clean Care" description="Original research, government guidance, and expert video presentations with notes on what each source supports."><section class="container section evidence-library"><p class="eyebrow">Documents, studies & video</p><h1>Follow the sources.</h1><p class="intro">Each resource is linked directly and paired with a short note on its scope. The goal is to help you check claims, see where evidence is strong, and recognize uncertainty.</p><div class="notice"><strong>How to read this library:</strong> A source showing that one ingredient can cause allergy does not prove that every fragrance, at every exposure level, has the same effect. Personal experiences matter for choosing what to avoid; claims about population-wide risk need suitable research.</div><div class="section-heading"><div><p class="eyebrow">Written sources</p><h2>Guidance and original research</h2></div></div><div class="resource-list">{publications.map(item => <article class="resource-card"><p class="eyebrow">{item.type}</p><h3><a href={item.href} target="_blank" rel="noopener noreferrer">{item.title} ↗</a></h3><p>{item.supports}</p></article>)}</div><div class="section-heading evidence-videos"><div><p class="eyebrow">Watch and learn</p><h2>Expert, reporting &amp; documentary video</h2></div></div><p class="sample-note">The collection distinguishes research presentations, medical education, reporting, and advocacy. A video’s inclusion does not validate every claim it contains; use its scope note and follow the linked written evidence.</p><div class="journal-grid">{learningVideos.map(video => <VideoCard video={video}/>)}</div><p class="editorial-note">Source list reviewed October 2026. New articles identify their source dates and separate observed results from interpretation.</p><a class="button" href={url('guides/')}>Read the articles ↗</a></section></Layout>
