---
import Layout from '../layouts/Layout.astro';
import DoctorBadge from '../components/DoctorBadge.astro';
import ProfileSourceNotes from '../components/ProfileSourceNotes.astro';
import { doctorStories } from '../data/doctor-stories.mjs';
import { url } from '../lib/paths';
---
<Layout title="Doctors & skin science: fragrance-free education | CleanCare" description="Meet four dermatologists and a chemistry PhD through their original educational resources, biographies and clearly disclosed brand interests.">
  <section class="container section expert-page">
    <p class="eyebrow">Expert voices · learn from the source</p>
    <h1>Doctors &amp; skin science.</h1>
    <p class="intro">Four dermatologists and a chemistry PhD exploring sensitive skin, ingredients and fragrance-free choices. Their perspectives differ: fragrance can cause contact allergy in susceptible people, but not everyone reacts. <a href="https://www.fda.gov/cosmetics/cosmetic-ingredients/allergens-cosmetics">Read the FDA’s cosmetic-allergen guidance ↗</a></p>
    <p class="notice">The doctor badge identifies a medical qualification—not a review or endorsement of CleanCare. Brand founders have commercial interests; brand policies are not independent clinical evidence. For persistent reactions, consult a qualified clinician.</p>
    <div class="expert-grid">
      {doctorStories.map((person, index) => <article class="celebrity-tile">
        <ProfileSourceNotes id={`expert-notes-${index}`} person={person}/>
        <a class="expert-link" href={person.source} target="_blank" rel="noopener noreferrer" aria-labelledby={`expert-${index}`}>
          <div class="expert-image">
            {person.image ? <img src={person.image} alt={person.imageAlt ?? person.name} loading="lazy" decoding="async" width="600" height="440" referrerpolicy="no-referrer"/> : <div class="science-profile" aria-hidden="true"><strong>{person.initials}</strong><span>Lab Muffin<br/>Beauty Science</span></div>}
            <div class="profile-badge">{person.doctor ? <DoctorBadge label="Dermatologist"/> : <span class="science-badge">Chemistry PhD</span>}</div>
          </div>
          <div class="expert-copy"><span class="expert-focus">{person.focus}</span><h2 id={`expert-${index}`}>{person.name}</h2><p class="credentials">{person.credentials}</p><p>{person.text}</p><span class="text-link">{person.sourceLabel} ↗</span></div>
        </a>
        <div class="profile-details"><a href={person.credentialUrl} target="_blank" rel="noopener noreferrer">Official biography ↗</a><p>{person.disclosure}</p>
          {person.related.length > 0 && <details><summary>More from this expert</summary><ul>{person.related.map(link => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul><p>Shared social links may require sign-in; they are not independently verified clinical evidence.</p></details>}
        </div>
      </article>)}
    </div>
    <aside class="context-next"><h2>Read the research alongside the commentary.</h2><p>Check the source type, the population studied and the limits of a claim. A professional qualification alone does not establish every statement.</p><a class="button" href={url('evidence/')}>Follow the sources →</a><a class="text-link" href={url('celebrity-stories/')}>Celebrity interviews &amp; personal stories →</a></aside>
  </section>
</Layout>
<style>
  .expert-page{padding-block:32px}.expert-page h1{font-size:clamp(30px,4vw,48px)}.intro{max-width:950px}.expert-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin-block:26px}.celebrity-tile{position:relative;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:var(--card);display:flex;flex-direction:column}.expert-link{color:var(--text);text-decoration:none;flex:1}.expert-image{height:180px;position:relative;background:var(--accent-sky);overflow:hidden}.expert-image img{width:100%;height:100%;object-fit:cover;object-position:center 25%}.profile-badge{position:absolute;left:12px;bottom:12px}.science-badge{padding:7px 11px;border-radius:999px;background:var(--accent-sky);color:#40584d;font-size:12px;font-weight:700}.science-profile{height:100%;display:flex;align-items:center;justify-content:center;gap:18px;color:#40584d}.science-profile strong{font-size:50px}.expert-copy{padding:18px}.expert-focus{font-size:12px;color:var(--muted)}.expert-copy h2{font-size:23px;line-height:1.25;margin:9px 0}.expert-copy p,.profile-details{font-size:13px;line-height:1.65}.expert-copy p{color:var(--muted)}.expert-copy .credentials{color:#40584d;font-size:12px;font-weight:600}.expert-copy .text-link{color:var(--link-color);font-size:13px}.profile-details{padding:0 18px 18px}.profile-details p{font-size:12px;color:var(--muted)}.profile-details summary{cursor:pointer;font-weight:600}.profile-details ul{padding-left:18px}.context-next .text-link{display:inline-block;margin-left:16px}@media(max-width:900px){.expert-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.expert-page{padding-block:20px}.expert-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-block:16px}.expert-image{height:96px}.profile-badge{left:7px;bottom:7px}.science-badge{padding:3px 6px;font-size:9px}.science-profile{gap:6px}.science-profile strong{font-size:31px}.science-profile span{font-size:9px;line-height:1.3}.expert-copy{padding:10px}.expert-focus{font-size:9px;line-height:1.3}.expert-copy h2{font-size:15px;line-height:1.28;margin:5px 0}.expert-copy p{display:none}.expert-copy .text-link{font-size:11px;line-height:1.35}.profile-details{display:none}.expert-page :global(.doctor-badge){gap:3px;padding:3px 6px;font-size:9px}.expert-page :global(.doctor-badge svg){width:12px;height:12px}.context-next .text-link{margin:14px 0 0}}@media(max-width:340px){.expert-grid{grid-template-columns:1fr}}
</style>
