---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import BrandLogo from '../../components/BrandLogo.astro';
import products from '../../data/product-catalog.mjs';
import { assertProductCatalog } from '../../lib/product-policy.mjs';
import { getEssentialOilStatus, getScentLabel } from '../../lib/scent-profile.mjs';
import { countryName } from '../../data/countries.mjs';
import { url } from '../../lib/paths';
export function getStaticPaths() { assertProductCatalog(products); return products.map(product => ({ params: { slug: product.id }, props: { product } })); }
const { product } = Astro.props;
const displayCategory = {
  'Skin & Body': 'Skincare & Body',
  'Home & Laundry': 'Cleaning & Laundry'
}[product.category] || product.category;
const imageIsBrandSource = product.imageSourceUrl === product.officialUrl;
const isNaturallyScented = product.fragranceStatus === 'naturally-scented';
const isScentedAlternative = ['essential-oils-only', 'naturally-scented'].includes(product.fragranceStatus);
const essentialOilStatus = getEssentialOilStatus(product);
const relatedProducts = products.filter(p => p.id !== product.id && ['essential-oils-only', 'naturally-scented'].includes(p.fragranceStatus) === isScentedAlternative && Object.keys(p.countries).some(code=>Object.hasOwn(product.countries,code))).sort((a,b) => Number(b.category === product.category) - Number(a.category === product.category)).slice(0,3);
// Distinguish regional formulas in search results, without an on-page country/date badge.
const marketTitle = Object.keys(product.countries).map(countryName).join(', ');
---
<Layout title={product.title + ' — ' + marketTitle + ' | CleanCare'} description={product.description + ' Read scent status, brand claims and limitations before choosing.'} image={product.image || url('images/editorial/home-fragrance-free-swaps.webp')} breadcrumbs={[{name:'Home',path:url()}, {name:'Fragrance-free products',path:url('directory/')}, {name:product.title,path:url('products/'+product.id+'/')}]}>
<article class="container section product-profile">
<a class="text-link" href={url('directory/')}>← All product profiles</a>
<div class="product-profile-brand"><BrandLogo brand={product.brand} variant="profile"/><span>{product.brand}</span></div>
<div class="product-profile-hero"><figure><a href={product.imageSourceUrl} rel="external">{product.image ? <img src={product.image} alt={product.imageAlt} width="700" height="700" fetchpriority="high" referrerpolicy="no-referrer"/> : <div class="product-image-placeholder"><strong>{product.brand}</strong><p>Product photo unavailable</p><span>View the official brand page ↗</span></div>}</a><figcaption>{product.image ? `Product image: ${product.brand}. ${imageIsBrandSource ? 'Loaded from the brand’s website' : 'Loaded from a checked retailer listing'}; image rights remain with its owner.` : 'No verified product image is displayed.'} Packaging may change.</figcaption></figure>
<div><p class="eyebrow">{displayCategory} · Product notes</p><h1>{product.title}</h1><div class="product-check-summary"><strong>{getScentLabel(product)}</strong></div><p class="intro">{product.description}</p><dl class="product-quick-facts"><div><dt>Category</dt><dd>{displayCategory}</dd></div><div><dt>Scent profile</dt><dd>{isNaturallyScented ? 'Naturally scented — manufacturer claim' : isScentedAlternative ? 'Scented with essential oils' : product.fragranceStatus === 'not-applicable' ? 'No product formula' : 'Fragrance-free claim'}</dd></div><div><dt>Essential-oil check</dt><dd>{essentialOilStatus === 'none-listed' ? 'None listed in the reviewed formula' : essentialOilStatus === 'contains' ? 'Present' : essentialOilStatus === 'not-applicable' ? 'Not applicable' : 'Not separately confirmed'}</dd></div></dl>{product.warning && <p class="product-warning"><strong>Ingredient note:</strong> {product.warning}</p>}<div class="tags">{product.tags.map(tag => <span>{tag}</span>)}</div><p class="product-disclosure">No affiliate link. This is a source-checked product profile, not a paid placement, personal trial, or medical recommendation.</p><a class="button" href={product.officialUrl} rel="external">Visit the official brand page ↗</a><p class="editorial-note">Prices and stock are not tracked. <a href={url('about/#product-method')}>How we check product sources →</a></p></div></div>
<div class="story-body product-details"><div class="prose">
<h2 id="scent-profile">Essential oils &amp; scent</h2><p><strong>{getScentLabel(product)}</strong></p><p>{product.scentEvidence || product.essentialOilEvidence || (product.category === 'Devices' ? 'This device has no product formula to classify.' : 'The fragrance-free claim was checked, but essential-oil absence has not yet been separately established. This product is excluded from the stricter no-essential-oils filter.')}</p>{product.essentialOilSource && <p><a href={product.essentialOilSource} rel="external">Official ingredient review source ↗</a>. This is a label review, not independent laboratory testing.</p>}
<h2 id="claim">What does the brand say?</h2><p>{product.claim}</p>{product.naturalFragranceSource && <p><a href={product.naturalFragranceSource} rel="external">Read the official no-synthetic-fragrance policy ↗</a>. Scent origin is reported as a manufacturer claim, not independently certified.</p>}<p>We are reporting a manufacturer statement, not independently certifying the formula or its suitability for you. <a href={product.officialUrl} rel="external">Check the original product page</a>.</p>
<h2 id="ingredients">What is in it?</h2><p>Use the current ingredient list on the official product page and your local packaging. We do not keep a copied list here because formulations and regional versions can change. Ask the brand if the two disagree.</p><p>{product.notes}</p>
<h2 id="use">What is it for?</h2><p>{product.use}</p>
<h2 id="country">Local availability</h2><p>Check current stock, shipping and the exact formula with the seller. Listings do not guarantee availability.</p><ul>{Object.entries(product.countries).map(([code, link]) => <li><a href={link} rel="external">{countryName(code)} — country listing ↗</a></li>)}</ul><p>Do not assume that another bottle with a similar name has the same formula. Confirm the exact product, country, and seller before purchasing.</p>
<h2 id="limits">Before you choose</h2><p>{isScentedAlternative ? 'Natural fragrances and essential oils are scented and can cause allergy or irritation. This is not a fragrance-free product or an appropriate option when you need to avoid all scent.' : 'Fragrance-free does not mean odorless or allergen-free.'} Check any ingredients you already know you need to avoid. For recurrent symptoms, seek individual advice rather than treating a product directory as a diagnostic tool.</p>{product.category === 'Oral Care' && <p>Fluoride has established cavity-prevention benefits. <a href="https://www.ada.org/resources/ada-library/oral-health-topics/toothpastes" rel="external">Read the American Dental Association’s toothpaste guidance</a> and discuss a suitable alternative with your dentist.</p>}<p><a href={url('guides/unscented-vs-fragrance-free/')}>Understand fragrance-free and unscented labels →</a></p>
</div><aside class="story-sidebar"><p class="eyebrow">In this profile</p><nav aria-label="Product contents"><a href="#scent-profile">Essential oils &amp; scent</a><a href="#claim">The brand’s claim</a><a href="#ingredients">Ingredients & caveats</a><a href="#use">Intended use</a><a href="#country">Country information</a><a href="#limits">Before you choose</a></nav><hr/><p>Product selection is a practical companion to the evidence—not the purpose of Clean Care.</p><a class="text-link" href={url('guides/')}>Read the journal →</a><a class="text-link" href={url('ingredient-checker/')}>Check an ingredient list →</a><a class="text-link" href={url('guides/fragrance-free-starter-toolkit/')}>Plan a category-by-category swap →</a></aside></div>
</article>{relatedProducts.length > 0 && <section class="container section"><div class="section-heading"><h2>More product notes</h2></div><div class="product-grid">{relatedProducts.map(p => <ProductCard product={p}/>)}</div></section>}
</Layout>
<style>.product-profile-brand{display:flex;align-items:center;gap:12px;margin:16px 0;font-size:14px;font-weight:600}.product-quick-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:16px 0}.product-quick-facts div{padding:11px;border:1px solid var(--border);border-radius:12px;background:#fff}.product-quick-facts dt{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}.product-quick-facts dd{margin:5px 0 0;font-size:12px;font-weight:600;line-height:1.4}.product-profile .story-sidebar .text-link{display:block;margin-top:12px}.product-image-placeholder { min-height: 320px; background: #edf3ee; color: #40584d; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 32px; text-align: center; } .product-image-placeholder strong { font-size: 32px; }@media(max-width:560px){.product-quick-facts{grid-template-columns:1fr}}</style>
