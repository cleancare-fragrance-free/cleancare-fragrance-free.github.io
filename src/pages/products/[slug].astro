---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/product-catalog.mjs';
import { assertProductCatalog } from '../../lib/product-policy.mjs';
import { getScentLabel } from '../../lib/scent-profile.mjs';
import { countryName } from '../../data/countries.mjs';
import { url } from '../../lib/paths';
export function getStaticPaths() { assertProductCatalog(products); return products.map(product => ({ params: { slug: product.id }, props: { product } })); }
const { product } = Astro.props;
const displayCategory = {
  'Skin & Body': 'Skincare & Body',
  'Home & Laundry': 'Cleaning & Laundry'
}[product.category] || product.category;
const imageIsBrandSource = product.imageSourceUrl === product.officialUrl;
const isEssentialOilAlternative = product.fragranceStatus === 'essential-oils-only';
const relatedProducts = products.filter(p => p.id !== product.id && (p.fragranceStatus === 'essential-oils-only') === isEssentialOilAlternative).sort((a,b) => Number(b.category === product.category) - Number(a.category === product.category)).slice(0,3);
---
<Layout title={product.title + ' | Clean Care product notes'} description={product.description}>
<article class="container section product-profile">
<a class="text-link" href={url('directory/')}>← All product profiles</a>
<div class="product-profile-hero"><figure><a href={product.imageSourceUrl} rel="external">{product.image ? <img src={product.image} alt={product.imageAlt} width="700" height="700" fetchpriority="high" referrerpolicy="no-referrer"/> : <div class="product-image-placeholder"><strong>{product.brand}</strong><p>Product photo unavailable</p><span>View the official brand page ↗</span></div>}</a><figcaption>{product.image ? `Product image: ${product.brand}. ${imageIsBrandSource ? 'Loaded from the brand’s website' : 'Loaded from a checked retailer listing'}; image rights remain with its owner.` : 'No verified product image is displayed.'} Packaging may change.</figcaption></figure>
<div><p class="eyebrow">{displayCategory} · Product notes</p><h1>{product.title}</h1><p class="intro">{product.description}</p>{product.warning && <p class="product-warning"><strong>Ingredient note:</strong> {product.warning}</p>}<div class="tags">{product.tags.map(tag => <span>{tag}</span>)}</div><p class="product-disclosure">No affiliate link. This is a source-checked product profile, not a paid placement, personal trial, or medical recommendation.</p><a class="button" href={product.officialUrl} rel="external">Visit the official brand page ↗</a><p class="editorial-note">Brand information checked <time datetime={product.checked}>{product.checked}</time>. Prices and stock are not tracked.</p></div></div>
<div class="story-body product-details"><div class="prose">
<h2 id="scent-profile">Essential oils &amp; scent</h2><p><strong>{getScentLabel(product)}</strong></p><p>{product.essentialOilEvidence || (product.category === 'Devices' ? 'This device has no product formula to classify.' : 'The fragrance-free claim was checked, but essential-oil absence has not yet been separately established. This product is excluded from the stricter no-essential-oils filter.')}</p>{product.essentialOilSource && <p><a href={product.essentialOilSource} rel="external">Official ingredient review source ↗</a> · checked {product.essentialOilChecked}. This is a label review, not independent laboratory testing.</p>}
<h2 id="claim">What does the brand say?</h2><p>{product.claim}</p><p>We are reporting a manufacturer statement, not independently certifying the formula or its suitability for you. <a href={product.officialUrl} rel="external">Check the original product page</a>.</p>
<h2 id="ingredients">What is in it?</h2><p>Use the current ingredient list on the official product page and your local packaging. We do not keep a copied list here because formulations and regional versions can change. Ask the brand if the two disagree.</p><p>{product.notes}</p>
<h2 id="use">What is it for?</h2><p>{product.use}</p>
<h2 id="country">Which country was checked?</h2><p>{product.countryNote}</p><ul>{Object.entries(product.countries).map(([code, link]) => <li><a href={link} rel="external">{countryName(code)} — country listing ↗</a></li>)}</ul><p>Do not assume that another bottle with a similar name has the same formula. Confirm the exact product, country, and seller before purchasing.</p>
<h2 id="limits">Before you choose</h2><p>{isEssentialOilAlternative ? 'Essential oils are scented and can cause allergy or irritation. This is not a fragrance-free product or an appropriate option when you need to avoid all scent.' : 'Fragrance-free does not mean odorless or allergen-free.'} Check any ingredients you already know you need to avoid. For recurrent symptoms, seek individual advice rather than treating a product directory as a diagnostic tool.</p>{product.category === 'Oral Care' && <p>Fluoride has established cavity-prevention benefits. <a href="https://www.ada.org/resources/ada-library/oral-health-topics/toothpastes" rel="external">Read the American Dental Association’s toothpaste guidance</a> and discuss a suitable alternative with your dentist.</p>}<p><a href={url('guides/unscented-vs-fragrance-free/')}>Understand fragrance-free and unscented labels →</a></p>
</div><aside class="story-sidebar"><p class="eyebrow">In this profile</p><nav aria-label="Product contents"><a href="#scent-profile">Essential oils &amp; scent</a><a href="#claim">The brand’s claim</a><a href="#ingredients">Ingredients & caveats</a><a href="#use">Intended use</a><a href="#country">Country information</a><a href="#limits">Before you choose</a></nav><hr/><p>Product selection is a practical companion to the evidence—not the purpose of Clean Care.</p><a class="text-link" href={url('guides/')}>Read the journal →</a></aside></div>
</article>{relatedProducts.length > 0 && <section class="container section"><div class="section-heading"><h2>More product notes</h2></div><div class="product-grid">{relatedProducts.map(p => <ProductCard product={p}/>)}</div></section>}
</Layout>
<style>.product-image-placeholder { min-height: 320px; background: #edf3ee; color: #40584d; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 32px; text-align: center; } .product-image-placeholder strong { font-size: 32px; }</style>
