---
import Layout from '../layouts/Layout.astro';
import EditorialIcon from '../components/EditorialIcon.astro';
import { url } from '../lib/paths';
const downloads = [
  {icon:'air', type:'PDF poster', preview:'air', previewLines:['We share', 'the air'], title:'We Share the Air poster', text:'University of Toronto EHS PDF poster for workplaces and shared indoor spaces.', href:'https://ehs.utoronto.ca/wp-content/uploads/2015/10/Scent-Policy-Poster.pdf', label:'Open PDF poster ↗'},
  {icon:'people', type:'PDF poster', preview:'space', previewLines:['A scent-free', 'shared space'], title:'Scent-free poster', text:'A second University of Toronto EHS poster layout for sharing a simple fragrance-aware request.', href:'https://ehs.utoronto.ca/wp-content/uploads/2018/01/Scentfree-Poster-20180129.pdf', label:'Open PDF poster ↗'},
  {icon:'label', type:'PDF decal', preview:'decal', previewLines:['Scent-free', 'shared space'], title:'2.5-inch scent-free decal', text:'University of Toronto EHS printable label concept for a door, meeting room or shared resource.', href:'https://ehs.utoronto.ca/wp-content/uploads/2018/05/scent-free-label-concept_-mar5_2018.pdf', label:'Open decal template ↗'},
  {icon:'book', type:'Word template', preview:'letter', previewLines:['A fragrance-aware', 'shared space'], title:'Sample communication letter', text:'University of Toronto EHS Word template for sharing scent-free guidelines with a group.', href:'https://ehs.utoronto.ca/wp-content/uploads/2018/01/Scent-Free-Guidelines-Sample-Communication-20180126.docx', label:'Download Word template ↗'},
];
---
<Layout title="We Share the Air | CleanCare" description="Respectful, practical resources for fragrance-aware shared spaces: posters, decals and sample communication templates.">
  <section class="share-hero"><div class="container share-hero-grid"><div><p class="eyebrow">We Share the Air</p><h1>One shared space.<br/><em>More room for everyone.</em></h1><p class="intro">A fragrance-aware request is not about judging someone’s choices. It is a practical way to reduce avoidable scent in a workplace, classroom, healthcare setting, event or home that people share.</p><div class="share-hero-actions"><a class="button" href="#resources">Browse posters &amp; templates</a><a class="text-link" href={url('guides/shared-spaces/')}>Read the shared-spaces guide →</a></div></div><figure class="share-illustration"><img src={url('images/we-share-the-air-printing-poster.png')} alt="A white desktop printer printing a pale green shared-air poster" loading="eager" decoding="async"/><span class="printer-poster" aria-hidden="true">We share<br/><b>the air</b></span><figcaption>Print a practical request for cleaner shared air.</figcaption></figure></div></section>

  <section id="resources" class="container share-resources"><div class="section-heading"><div><p class="eyebrow">Ready to print</p><h2>Posters, decals &amp; letters.</h2></div><p>These simplified thumbnails show the file type, not a reproduction of the original. Open the publisher’s source before printing or adapting, and follow its terms of use.</p></div><div class="share-resource-grid">{downloads.map(item => <article class:list={['print-resource', `print-resource--${item.preview}`]}><div class="print-preview" aria-hidden="true"><span class="print-preview-format">{item.type.split(' ')[0]}</span><span class="print-preview-icon"><EditorialIcon name={item.icon}/></span><span class="print-preview-copy">{item.previewLines.map(line => <strong>{line}</strong>)}</span><span class="print-preview-lines"><i></i><i></i><i></i></span></div><p class="print-resource-type">{item.type}</p><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></article>)}</div></section>

  <section class="container letter-section"><div><p class="eyebrow">Simple communication starters</p><h2>Begin with an invitation, not an accusation.</h2><p>Use a tone that is specific, practical and inclusive. Edit the wording for your setting, and avoid presenting a general request as a medical diagnosis of another person.</p></div><div class="letter-list"><details open><summary>Template: a workplace or event request</summary><div><p><strong>Subject:</strong> A fragrance-aware request for our shared space</p><p>Hello [name/team],</p><p>To help make our shared space more comfortable for people who are sensitive to scented products, could we ask attendees to avoid perfume, cologne, air fresheners and strongly fragranced personal-care products for [meeting/event]? This is a simple, voluntary way to reduce avoidable scent in the room.</p><p>Thank you for helping create a more inclusive environment. I can share a short poster or source-led information if useful.</p><p>Best,<br/>[your name]</p></div></details><details><summary>Template: feedback for a business or public space</summary><div><p>Hello [business/organisation],</p><p>I value your space and would like to ask whether you could reduce or remove air fresheners and strongly fragranced products in customer areas. A lower-scent environment can make it easier for people with fragrance sensitivities to visit and work comfortably.</p><p>If scent is being used to cover an odour, addressing the source may be more effective. Thank you for considering this practical accessibility step.</p><p>Kind regards,<br/>[your name]</p></div></details><a class="text-link" href="https://www.naturallynorny.com/letter-templates.html" target="_blank" rel="noopener noreferrer">More community letter templates from Naturally Norny ↗</a></div></section>

  <section class="container share-note"><span><EditorialIcon name="heart"/></span><div><p class="eyebrow">A shared approach</p><h2>Make the request easy to honour.</h2><p>Give advance notice, offer a clear example of what to avoid, and focus on the setting—not on policing people. A poster works best alongside practical policies: fragrance-free cleaning and laundry products, no plug-ins or sprays in common areas, and a way to raise concerns respectfully.</p></div><a class="button" href={url('take-action/')}>Explore Take Action →</a></section>
</Layout>
<style>
 .share-hero{padding:68px 0;background:linear-gradient(135deg,#fbf9f6 0%,#e9f4f4 64%,#edf3e6 100%);border-bottom:1px solid var(--border)}.share-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}.share-hero h1{margin:10px 0 20px;font-size:clamp(44px,5.8vw,76px);line-height:1.03;letter-spacing:-.055em}.share-hero h1 em{font-family:Georgia,serif;font-weight:400;color:#587d6c}.share-hero-actions{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:24px}.share-illustration{position:relative;overflow:hidden;margin:0;border-radius:28px;background:#fff;box-shadow:0 18px 42px #40584d14}.share-illustration img{display:block;width:100%;aspect-ratio:1.38;object-fit:cover}.printer-poster{position:absolute;right:24%;bottom:9%;z-index:1;display:grid;place-items:center;width:23%;min-height:24%;padding:8px 6px;border:1px solid #b7cabb;border-radius:3px;background:#fffdf9;color:#466958;font-family:Georgia,serif;font-size:clamp(9px,1.1vw,15px);line-height:1.05;text-align:center;transform:rotate(14deg);box-shadow:0 3px 9px #28352d25}.printer-poster b{font-weight:700}.share-illustration figcaption{position:absolute;right:12px;bottom:10px;z-index:2;margin:0;border-radius:999px;padding:4px 7px;background:#ffffffd9;color:#526c60;font-size:9px;line-height:1.25}.share-resources{padding-block:58px}.section-heading>p{max-width:455px;margin:0;color:var(--muted);font-size:13px;line-height:1.7}.share-resource-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.share-resource-grid .print-resource{display:flex;min-height:362px;flex-direction:column;padding:16px 18px 20px;border:1px solid var(--border);border-radius:20px;background:#fff}.print-preview{position:relative;display:flex;min-height:137px;align-items:center;justify-content:center;overflow:hidden;border:1px solid #e6e0d7;border-radius:12px;background:#f7fbf7;box-shadow:0 4px 12px #4e695610}.print-preview::before{position:absolute;inset:8px;content:'';border:1px solid #b8ccbf;pointer-events:none}.print-preview-format{position:absolute;z-index:1;top:9px;right:9px;padding:3px 6px;border-radius:999px;background:#fff;color:#496d60;font-size:8px;font-weight:800;letter-spacing:.08em}.print-preview-icon{position:absolute;top:21px;left:18px;color:#6c9a88}.print-preview-icon :global(.editorial-icon){width:28px;height:28px}.print-preview-copy{position:relative;z-index:1;display:grid;gap:1px;max-width:142px;text-align:center;text-transform:uppercase}.print-preview-copy strong{font-size:14px;line-height:1.03;letter-spacing:.055em}.print-preview-lines{position:absolute;z-index:1;right:17px;bottom:19px;display:grid;gap:4px;width:54px}.print-preview-lines i{display:block;height:2px;border-radius:999px;background:#a9c0b2}.print-preview-lines i:nth-child(2){width:84%}.print-preview-lines i:nth-child(3){width:66%}.print-resource--space .print-preview{background:#edf4f8}.print-resource--space .print-preview::before{border-color:#afc9d5}.print-resource--space .print-preview-icon{color:#7da3b3}.print-resource--decal .print-preview{min-height:137px;background:#fff6e9}.print-resource--decal .print-preview::before{inset:23px 12px;border:2px dashed #e8ae71;border-radius:999px}.print-resource--decal .print-preview-icon{top:49px;left:28px;color:#cd8747}.print-resource--decal .print-preview-copy{max-width:145px;margin-left:18px;font-size:12px}.print-resource--decal .print-preview-lines{display:none}.print-resource--letter .print-preview{align-items:flex-start;justify-content:flex-start;padding:21px 19px;background:#f8f7f4}.print-resource--letter .print-preview::before{inset:8px;background:#fff;border-color:#e4dfd7}.print-resource--letter .print-preview-icon{z-index:1;top:20px;left:auto;right:18px;color:#7897a8}.print-resource--letter .print-preview-copy{margin-top:16px;max-width:157px;text-align:left}.print-resource--letter .print-preview-copy strong{font-size:9px;letter-spacing:.06em}.print-resource--letter .print-preview-lines{z-index:1;right:auto;bottom:21px;left:20px;width:72%}.print-resource-type{margin:14px 0 7px!important;color:#668374!important;font-size:9px!important;font-weight:800;letter-spacing:.09em;line-height:1.2!important;text-transform:uppercase}.share-resource-grid h3{margin:0 0 9px;font-size:17px;line-height:1.3}.share-resource-grid p{margin:0 0 15px;color:var(--muted);font-size:12px;line-height:1.62}.share-resource-grid .text-link{margin-top:auto;font-size:12px}.letter-section{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;padding:40px;border-radius:24px;background:#fffaf4}.letter-section h2{margin:6px 0 12px;font-size:clamp(30px,3.5vw,46px);line-height:1.1}.letter-section>div>p:not(.eyebrow){margin:0;color:var(--muted);line-height:1.8}.letter-list{display:grid;gap:10px}.letter-list details{border:1px solid var(--border);border-radius:13px;background:#fff;padding:0 17px}.letter-list summary{padding:16px 0;font-weight:700;cursor:pointer}.letter-list details div{padding:0 0 16px;color:var(--muted);font-size:13px;line-height:1.7}.letter-list details p{margin:0 0 10px}.letter-list details p:last-child{margin-bottom:0}.letter-list>a{margin-top:5px;font-size:13px}.share-note{display:grid;grid-template-columns:48px 1fr auto;gap:20px;align-items:center;margin-block:58px;padding:34px;border:1px solid var(--border);border-radius:24px;background:#fff}.share-note>span{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#edf3e6}.share-note h2{margin:6px 0 10px;font-size:30px}.share-note p:last-child{max-width:750px;margin:0;color:var(--muted);line-height:1.75}@media(max-width:900px){.share-hero-grid,.letter-section{grid-template-columns:1fr}.share-resource-grid{grid-template-columns:1fr 1fr}.share-illustration{max-width:560px}.share-note{align-items:flex-start;grid-template-columns:48px 1fr}.share-note .button{grid-column:2;justify-self:start}}@media(max-width:560px){.share-hero{padding:44px 0}.share-resource-grid{grid-template-columns:1fr}.letter-section,.share-note{padding:24px}.share-hero-actions{align-items:flex-start;flex-direction:column}.share-note{margin-block:36px;gap:14px}.share-note h2{font-size:27px}.printer-poster{right:24%;bottom:11%;padding:5px 4px;font-size:11px}.share-illustration figcaption{right:8px;bottom:8px;font-size:8px}}
</style>
