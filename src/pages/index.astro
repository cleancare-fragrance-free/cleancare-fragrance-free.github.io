---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles.mjs';
import { url } from '../lib/paths';
const pathways = [
  { number: '01', label: 'The cause', title: 'Where exposure begins', description: 'Fragrance can appear in personal care, laundry, cleaning, and air-freshening products. Learn what labels disclose and what they may leave unclear.', href: 'guides/fragrance-health-evidence/' },
  { number: '02', label: 'The consequences', title: 'What health research shows', description: 'Fragrance ingredients can trigger contact allergy in some people; some report respiratory symptoms. The evidence varies by ingredient and exposure.', href: 'guides/fragrance-health-evidence/#health-effects' },
  { number: '03', label: 'The alternatives', title: 'Ways to reduce exposure', description: 'Find practical steps for home and daily routines, plus guidance on comparing fragrance-free claims without relying on marketing alone.', href: 'guides/reduce-fragrance-exposure/' },
];
const topReasons = [
  { title: 'Less skin irritation and allergy', text: 'Fragrance ingredients can cause contact dermatitis or other reactions in some people. Removing added scent eliminates one common group of potential triggers.' },
  { title: 'Fewer scent-triggered symptoms', text: 'Some people report headache, nausea, eye or airway irritation around scented products. Individual triggers and responses vary, so symptom patterns deserve context—not assumptions.' },
  { title: 'Fewer unnecessary fragrance ingredients', text: 'A label may use the single word “fragrance” for a complex mixture. Choosing fragrance-free reduces an exposure that is optional in many personal-care and household products.' },
  { title: 'Cleaner shared indoor air', text: 'Scented consumer products can add volatile compounds to indoor air. Source reduction and ventilation are practical ways to reduce avoidable emissions.' },
  { title: 'More control and transparency', text: 'A simpler, fragrance-free routine makes products easier to compare and can help you identify which ingredients or exposures coincide with symptoms.' },
];
---
<Layout>
<section class="container reasons-hero"><div class="reasons-heading"><p class="eyebrow">A clear place to begin</p><h1>Top 5 Reasons to Go Fragrance-Free <em>— and only use natural essential oils</em></h1><p class="reasons-caveat"><strong>Important distinction:</strong> natural essential oils are still fragrance. They can contain allergens and trigger symptoms, so people seeking strict fragrance avoidance should avoid them too.</p><a class="text-link" href={url('why-fragrance-free/')}>Explore why fragrance-free matters <span>→</span></a></div><ol class="reasons-list">{topReasons.map((reason, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{reason.title}</strong><p>{reason.text}</p></div></li>)}</ol><p class="source-note">Topic inspiration: <a href="https://www.sabaorganics.com/blogs/wellness-hub/top-5-reasons-to-go-fragrance-free" rel="external">Saba Organic</a>. CleanCare’s wording and cautions are independently reviewed against the linked public-health sources.</p></section>
<section class="container hero editorial-hero"><div class="hero-copy"><p class="eyebrow"><span></span> Fragrance, health & informed choices</p><h1>Understand what’s<br/>in the air <em>around you.</em></h1><p class="intro">Fragrance is part of everyday life. This site explores where exposure comes from, what research says about possible health effects, and how to find alternatives—with sources you can check yourself.</p><div class="hero-actions"><a class="button" href={url('guides/fragrance-health-evidence/')}>Start with the evidence <span>↗</span></a><a class="text-link" href={url('evidence/')}>Browse the sources <span>→</span></a></div><div class="hero-note"><span>✳</span> Clear claims. Direct references. Room for uncertainty.</div></div>
<div class="research-scene" role="img" aria-label="Illustration of a research notebook, a source document, and a botanical branch"><div class="research-arch"></div><div class="research-page page-one"><span>FIELD NOTES / 01</span><strong>Fragrance &<br/>everyday exposure</strong><p>CAUSE<br/>EFFECT<br/>EVIDENCE<br/>ALTERNATIVES</p></div><div class="research-page page-two"><span>THE EVIDENCE</span><strong>Follow the<br/><em>sources.</em></strong><div class="research-lines"><i></i><i></i><i></i><i></i></div><small>Clean Care · research notebook</small></div><svg class="research-leaf" viewBox="0 0 150 270" fill="none" aria-hidden="true"><path d="M78 262C79 181 48 103 63 12" stroke="#526e58" stroke-width="2"/><g fill="#7c9278"><path d="M63 55C29 41 22 18 24 3c34 7 41 26 39 52ZM62 85c16-35 40-44 61-39-9 26-27 37-61 39ZM67 136c-38-7-55-33-54-51 35 5 53 23 54 51ZM72 184c9-40 35-52 59-50-8 28-26 45-59 50ZM79 231c-38-10-55-35-54-53 34 8 50 27 54 53Z"/></g></svg><span class="research-caption">Read. Question. Decide.</span></div></section>
<div class="principles"><div class="container"><span>What you’ll find here</span><span>↳ Health context</span><span>↳ Original sources</span><span>↳ Practical alternatives</span></div></div>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Start with the questions</p><h2>The story behind a scent.</h2></div><p>Understand the issue before changing a routine.</p></div><div class="category-grid">{pathways.map(item => <a class="category-card editorial-card" href={url(item.href)}><div class="category-top"><span>{item.number} / {item.label}</span><span class="category-icon">↗</span></div><h3>{item.title}</h3><p>{item.description}</p><span class="category-arrow">Read the article →</span></a>)}</div></section>
<section class="container guide-feature evidence-feature"><div class="guide-art" aria-hidden="true"><div class="paper paper-back">QUESTION<span>What is in the product?</span></div><div class="paper paper-front">READ<br/>THE SOURCE<span>What does the evidence actually show?</span><i>the clean care library / 01</i></div></div><div class="guide-feature-copy"><p class="eyebrow">Source library · publications & video</p><h2>Follow the evidence<br/>for yourself.</h2><p>Read agency guidance, a population study on fragrance allergy, and recorded discussions about indoor air. Each resource is labeled so you can see what it covers—and what it does not establish.</p><a class="text-link" href={url('evidence/')}>Open the evidence library <span>→</span></a></div></section>
<section class="container alternatives-band"><div><p class="eyebrow">A naturally clean home</p><h2>Use less. Clean well. Breathe easier.</h2><p>Build a practical, lower-toxicity routine with fragrance-free methods, room-by-room swaps, DIY ingredient cautions, and books for further learning.</p></div><a class="button" href={url('non-toxic-home/')}>Open the home guide ↗</a></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Latest reading</p><h2>Guides for a clearer picture.</h2></div><a class="text-link" href={url('guides/')}>All articles ↗</a></div><div class="journal-grid">{[articles[4], articles[0], articles[5]].map(article => <ArticleCard article={article}/>)}</div></section>
<section class="container alternatives-band"><div><p class="eyebrow">A practical companion</p><h2>Looking for fragrance-free options?</h2><p>Explore product profiles with official brand images, ingredient-source links, and clear limitations. Browse checked sources for the US, UK, Singapore, Australia and New Zealand, with country-specific details and no affiliate links.</p></div><a class="button" href={url('directory/')}>Explore alternatives ↗</a></section>
<section class="container quiz-invitation"><div><p class="eyebrow">Your everyday experience</p><h2>Could scented products be part of the picture?</h2><p>Explore the products you use and symptoms you notice in a private, seven-question quiz. Get a product-use summary and practical alternatives—not a diagnosis or sensitivity score.</p></div><a class="button" href={url('self-check/')}>Take the self-check <span>→</span></a></section>
<section class="container founder-story"><div class="founder-story-mark" aria-hidden="true"><span>Our story</span><strong>One family.<br/>One change.<br/>A wider mission.</strong></div><div><p class="eyebrow">About CleanCare</p><h2>It began with a change at home.</h2><p>After becoming sensitive to synthetic fragrances—and seeing similar reactions within her family—CleanCare’s founder removed fragranced products from their environment. The improvement they noticed inspired a mission: help others understand the issue, follow the evidence, and find practical fragrance-free solutions.</p><a class="text-link" href={url('about-us/')}>Read our story <span>→</span></a></div></section>
<section class="closing"><div class="container"><p class="eyebrow">Our editorial approach</p><h2>Make space for the evidence,<br/>and for individual experience.</h2><a class="button" href={url('about/')}>How we review information <span>↗</span></a></div></section>
</Layout>

<style>
  .founder-story{display:grid;grid-template-columns:minmax(280px,.8fr) 1.2fr;gap:64px;align-items:center;margin-block:70px;padding:34px;border:1px solid var(--border);border-radius:24px;background:#fff}.founder-story-mark{display:flex;min-height:260px;flex-direction:column;justify-content:space-between;padding:30px;border-radius:18px;background:linear-gradient(145deg,#dfeadd,#e8f3f8)}.founder-story-mark span{color:var(--muted);font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.founder-story-mark strong{font-family:Georgia,serif;font-size:clamp(30px,3.2vw,43px);font-weight:400;line-height:1.08;color:#526e58}.founder-story h2{margin:7px 0 14px;font-size:clamp(32px,4vw,49px);line-height:1.1}.founder-story p:not(.eyebrow){max-width:700px;color:var(--muted);line-height:1.8}.founder-story .text-link{display:inline-flex;margin-top:12px}
  @media(max-width:800px){.founder-story{grid-template-columns:1fr;gap:28px;margin-block:48px;padding:22px}.founder-story-mark{min-height:210px}}
</style>
