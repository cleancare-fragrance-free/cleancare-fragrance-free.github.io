---
import Layout from '../layouts/Layout.astro';
import EditorialIcon from '../components/EditorialIcon.astro';
import { url } from '../lib/paths';
const actions = [
  {icon:'label', title:'Ask for clearer labels', text:'Ask brands to publish full fragrance ingredients, the function of each ingredient, and current formula information—not only a front-label claim.'},
  {icon:'people', title:'Make shared spaces easier', text:'Request a lower-fragrance meeting, classroom, workplace or community event. Lead with a specific, respectful change that people can follow.'},
  {icon:'book', title:'Share sources, not slogans', text:'Pass on public-health guidance, reporting and original research with their limits. This helps people verify a claim before repeating it.'},
  {icon:'leaf', title:'Reduce optional scent', text:'Choose the smallest practical swap—such as an unscented laundry extra or no air freshener—and use disposal guidance for unused liquids.'},
];
---
<Layout title="Take Action | CleanCare" description="Practical, source-led ways to ask for fragrance transparency, reduce avoidable scent exposure and support healthier shared environments.">
  <section class="action-hero"><div class="container action-hero-grid"><div><p class="eyebrow">Take Action</p><h1>Better information.<br/><em>Healthier shared spaces.</em></h1><p class="intro">Individual swaps matter, but transparency and community action make it easier for everyone to make informed choices. Start with one specific ask and keep the evidence attached.</p><div class="action-hero-links"><a class="button" href="https://www.safecosmetics.org/action-alerts/we-need-safer-beauty-for-all/" target="_blank" rel="noopener noreferrer">Explore Campaign for Safe Cosmetics actions ↗</a><a class="text-link" href={url('guides/fragrance-and-environment/')}>Read the environmental guide →</a></div></div><div class="action-visual" aria-label="Original illustration of a fragrance bottle with label, air and water icons"><svg viewBox="0 0 400 320" role="img"><path d="M149 83h102v39l37 43v104a22 22 0 0 1-22 22H134a22 22 0 0 1-22-22V165l37-43Z" fill="#fffdf9" stroke="#496d60" stroke-width="6" stroke-linejoin="round"/><path d="M164 48h72v35h-72z" fill="#94b3a7" stroke="#496d60" stroke-width="6"/><path d="M135 171h130v69H135z" fill="#e8f3f8"/><path d="M157 195h87m-87 18h62" stroke="#78928a" stroke-width="5" stroke-linecap="round"/><path d="M73 103c22-18 49-18 71 0m-71 25c22-18 49-18 71 0" fill="none" stroke="#78a59a" stroke-width="6" stroke-linecap="round"/><path d="M283 214c15-16 31-16 46 0s28 16 40 0m-86 24c15-16 31-16 46 0s28 16 40 0" fill="none" stroke="#6d9db6" stroke-width="6" stroke-linecap="round"/><path d="M59 264c35-23 77-23 112 0s78 23 113 0 76-23 111 0" fill="none" stroke="#8fb09a" stroke-width="7" stroke-linecap="round"/></svg><p>Original CleanCare illustration</p></div></div></section>

  <section class="container action-grid" aria-label="Four ways to take action">{actions.map(action => <article><span><EditorialIcon name={action.icon}/></span><h2>{action.title}</h2><p>{action.text}</p></article>)}</section>

  <section class="container action-policy"><div><p class="eyebrow">Transparency and policy</p><h2>Ask for information people can use.</h2><p>Fragrance disclosure is an advocacy issue with differing policy proposals. CleanCare does not claim that disclosure alone proves a product is safe or unsafe. It helps consumers, clinicians, researchers and regulators see more of what is in a product and ask better questions.</p></div><div class="policy-links"><a href="https://www.safecosmetics.org/resources/health-science/fragrance-disclosure/" target="_blank" rel="noopener noreferrer"><strong>Campaign for Safe Cosmetics</strong><span>Read its fragrance-disclosure advocacy and supporting resources ↗</span></a><a href="https://www.congress.gov/bill/119th-congress/house-bill/4435" target="_blank" rel="noopener noreferrer"><strong>U.S. federal proposal</strong><span>Track H.R. 4435, introduced in 2025 and referred to committee; check Congress.gov for its current status ↗</span></a><a href="https://www.cdph.ca.gov/Programs/CCDPHP/DEODC/OHB/CSCP/Pages/SB312.aspx" target="_blank" rel="noopener noreferrer"><strong>California disclosure reporting</strong><span>Learn how SB 312 reporting works and use the state’s public product database ↗</span></a></div></section>

  <section class="container action-note"><div><p class="eyebrow">Keep it constructive</p><h2>Advocacy works better with precision.</h2><p>Focus on transparency, accessible fragrance-aware spaces and source-backed discussion. Avoid diagnosing other people, harassing brands or presenting a product category as universally harmful without evidence about the actual formula and exposure.</p></div><a class="button" href={url('about-us/')}>Read why CleanCare exists →</a></section>
</Layout>
<style>
 .action-hero{padding:68px 0;background:linear-gradient(135deg,#fbf9f6 0%,#edf5ef 60%,#e8f3f8 100%);border-bottom:1px solid var(--border)}.action-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}.action-hero h1{margin:10px 0 20px;font-size:clamp(44px,5.8vw,76px);line-height:1.03;letter-spacing:-.055em}.action-hero h1 em{font-family:Georgia,serif;font-weight:400;color:#587d6c}.action-hero-links{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:24px}.action-visual{padding:20px;border-radius:42% 42% 18px 18px;background:#fff;box-shadow:0 18px 42px #40584d14}.action-visual svg{display:block;width:100%;height:auto}.action-visual p{margin:2px 0 0;color:var(--muted);font-size:10px;text-align:center}.action-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;padding-block:58px}.action-grid article{padding:24px;border:1px solid var(--border);border-radius:20px;background:#fff}.action-grid article>span{display:grid;place-items:center;width:42px;height:42px;margin-bottom:25px;border-radius:50%;background:var(--accent-sky)}.action-grid h2{margin:0 0 10px;font-size:19px;line-height:1.35}.action-grid p{margin:0;color:var(--muted);font-size:13px;line-height:1.7}.action-policy{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;padding:40px;border-radius:24px;background:#293f39;color:#fff}.action-policy .eyebrow{color:#c5d9cc}.action-policy h2{margin:6px 0 12px;font-size:clamp(30px,3.5vw,46px);line-height:1.1}.action-policy p:not(.eyebrow){margin:0;color:#dfe8e2;line-height:1.8}.policy-links{display:grid;gap:10px}.policy-links a{display:grid;gap:4px;padding:16px;border:1px solid #ffffff2b;border-radius:13px;color:#fff}.policy-links a:hover{background:#ffffff12;text-decoration:none}.policy-links span{color:#d6e4db;font-size:12px;line-height:1.55}.action-note{display:flex;justify-content:space-between;align-items:center;gap:28px;margin-block:58px;padding:36px;border:1px solid var(--border);border-radius:24px;background:#fffaf4}.action-note h2{margin:6px 0 10px;font-size:30px}.action-note p:last-child{max-width:740px;margin:0;color:var(--muted);line-height:1.75}@media(max-width:900px){.action-hero-grid,.action-policy{grid-template-columns:1fr}.action-grid{grid-template-columns:1fr 1fr}.action-visual{max-width:480px}.action-note{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.action-hero{padding:44px 0}.action-grid{grid-template-columns:1fr;padding-block:36px}.action-policy,.action-note{padding:24px}.action-hero-links{align-items:flex-start;flex-direction:column}.action-hero-links .button{max-width:100%;text-align:center}.action-note{margin-block:36px}}
</style>
