---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';

const foundations = [
  { number: '01', title: 'Remove the source', text: 'Skip air fresheners, scented candles, incense, scent boosters, dryer sheets, and fragranced sprays. Fewer sources usually means fewer added emissions indoors.' },
  { number: '02', title: 'Clean with less', text: 'Start with a damp microfiber cloth, water, and a small amount of fragrance-free detergent used according to its label. More product is not automatically more effective.' },
  { number: '03', title: 'Ventilate thoughtfully', text: 'Use exhaust fans and open windows when outdoor air quality and weather allow. Ventilate during and after cleaning, especially in small rooms.' },
  { number: '04', title: 'Control moisture', text: 'Fix leaks, dry wet materials promptly, and use bathroom and kitchen exhaust. Moisture control helps prevent conditions that support mold growth.' },
];

const ingredients = [
  { name: 'White vinegar', role: 'For mineral scale on compatible surfaces', text: 'Its acidity can help loosen limescale and soap residue. It is not a reliable general-purpose disinfectant and can damage natural stone and some finishes.', caution: 'Never mix with bleach, hydrogen peroxide, or another cleaner. Test a hidden area first.' },
  { name: 'Baking soda', role: 'For gentle scrubbing and odor absorption', text: 'Use a little baking soda with water as a mild abrasive on compatible, non-delicate surfaces. Wipe away residue and avoid breathing dust.', caution: 'It can scratch some finishes. Test first and keep the container dry.' },
  { name: 'Washing soda', role: 'For heavier laundry or grease tasks', text: 'Washing soda is more alkaline and stronger than baking soda. Use only as directed on the package and check fabric and surface compatibility.', caution: 'It can irritate eyes and skin. Wear gloves, avoid dust, and store away from children and pets.' },
  { name: 'Borax', role: 'Optional laundry and cleaning booster', text: 'Borax is sometimes promoted as “natural,” but that does not make it harmless. The US EPA associates it with reproductive, developmental, and neurological hazards.', caution: 'Not a default recommendation. Follow the label, avoid dust and ingestion, and keep securely away from children and pets.' },
];

const roomPlan = [
  { room: 'Laundry', swap: 'Use a fragrance-free detergent and stop fabric softener, scent beads, and dryer sheets. Rewash heavily scented textiles and air them outdoors when practical.' },
  { room: 'Kitchen', swap: 'Choose fragrance-free dish and surface products. Wipe grease with warm water and detergent; reserve disinfectants for situations that actually require them.' },
  { room: 'Bathroom', swap: 'Run the exhaust fan, dry wet surfaces, and address scale with a compatible cleaner. Avoid fragranced toilet blocks, plug-ins, and aerosol deodorizers.' },
  { room: 'Living spaces', swap: 'Damp-dust, vacuum with appropriate filtration, and remove scent sources rather than masking odors. Check candles, diffusers, incense, and fragranced décor.' },
  { room: 'Bedroom', swap: 'Wash bedding with fragrance-free detergent, store scented personal-care products outside the sleeping area, and keep indoor humidity controlled.' },
  { room: 'Shared spaces', swap: 'Explain the specific product or activity that is difficult for you and request one practical change, such as skipping a diffuser or using an unscented cleaner.' },
];
---

<Layout title="A naturally clean, lower-toxicity home | CleanCare" description="A practical, fragrance-free home guide: source reduction, safer cleaning methods, DIY ingredient cautions, room-by-room swaps, and further reading.">
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div>
        <p class="eyebrow">Non-Toxic Home</p>
        <h1>A naturally clean home,<br/><em>without the cloud of scent.</em></h1>
        <p class="intro">A practical guide to reducing fragranced products, simplifying cleaning, and choosing lower-exposure methods that fit real homes and real budgets.</p>
        <div class="hero-actions"><a class="button" href="#room-plan">Start room by room <span>↓</span></a><a class="text-link" href={url('directory/?category=Cleaning')}>Browse cleaning products <span>→</span></a></div>
      </div>
      <div class="home-illustration" aria-hidden="true"><span class="sun"></span><span class="house"><i></i></span><span class="leaf leaf-one"></span><span class="leaf leaf-two"></span><p>LESS SCENT<br/><strong>MORE AIR</strong></p></div>
    </div>
  </section>

  <section class="container definition-note" aria-labelledby="meaning-title">
    <p class="eyebrow">A useful goal, not a guarantee</p>
    <h2 id="meaning-title">What “non-toxic” means here</h2>
    <p>“Non-toxic” is not a promise that an ingredient is harmless in every amount or situation. Everything—including plant-derived substances—has a dose, route, and context. CleanCare uses the phrase as familiar shorthand for a home with fewer unnecessary fragrance sources and thoughtfully chosen, lower-hazard methods. <strong>Fragrance-free, well ventilated, label-led, and safely stored</strong> are more precise goals.</p>
  </section>

  <section class="container section">
    <div class="section-heading"><div><p class="eyebrow">Begin with the basics</p><h2>Methods before mixtures.</h2></div><p>The simplest change is often removing a source, not adding another product.</p></div>
    <div class="foundation-grid">{foundations.map(item => <article><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
  </section>

  <section class="safety-band">
    <div class="container safety-grid">
      <div><p class="eyebrow">Cleaning is not disinfecting</p><h2>Use the least intensive method that fits the task.</h2></div>
      <div><p>Routine cleaning removes dirt and many germs with water, friction, and detergent. Disinfecting uses a registered antimicrobial product and may be appropriate for specific health situations or high-touch surfaces.</p><p>If disinfection is needed, choose an appropriately registered product and follow its label, dilution, surface, ventilation, and contact-time directions.</p><strong>Never mix cleaning products or add bleach to other chemicals. Mixing can create toxic vapors.</strong></div>
    </div>
  </section>

  <section class="container section ingredients-section">
    <div class="section-heading"><div><p class="eyebrow">DIY ingredient guide</p><h2>Useful does not mean risk-free.</h2></div><p>Keep every ingredient in its original labeled container and out of reach of children and pets.</p></div>
    <div class="ingredient-grid">{ingredients.map(item => <article><p class="ingredient-role">{item.role}</p><h3>{item.name}</h3><p>{item.text}</p><div class="caution"><strong>Use with care</strong><span>{item.caution}</span></div></article>)}</div>
    <p class="source-note">Safety context: <a href="https://www.epa.gov/saferchoice/frequently-asked-questions-safer-choice">US EPA Safer Choice FAQ</a> and <a href="https://www.epa.gov/indoor-air-quality-iaq/biological-contaminants-and-indoor-air-quality">EPA indoor-air cleaning guidance</a>.</p>
  </section>

  <section id="room-plan" class="container section room-section">
    <div class="section-heading"><div><p class="eyebrow">The complete-home reset</p><h2>Work one room at a time.</h2></div><p>Finish one category before buying replacements for the next.</p></div>
    <div class="room-list">{roomPlan.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.room}</h3><p>{item.swap}</p></div></article>)}</div>
    <div class="room-actions"><a class="button" href={url('guides/fragrance-free-starter-toolkit/')}>Open the replacement toolkit ↗</a><a class="text-link" href={url('directory/')}>Find fragrance-free products by country <span>→</span></a></div>
  </section>

  <section class="reading-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Books & further reading</p><h2>Build a method you can maintain.</h2></div><p>Reader resources are ideas, not independent safety certification. Check every recipe against product labels and authoritative guidance.</p></div>
      <div class="book-grid">
        <a class="book-card" href="https://www.panmacmillan.com.au/9781529049749/" target="_blank" rel="noopener noreferrer"><div class="book-cover clean-green"><span>101 hints &amp; tips</span><strong>Clean<br/>&amp; Green</strong><small>Nancy Birtwhistle</small></div><div><p class="eyebrow">Publisher page</p><h3>Clean &amp; Green</h3><p>Practical recipes and routines for a more eco-friendly, lower-waste home. Use the book for ideas, then apply the ingredient and mixing cautions on this page.</p><span>View the book →</span></div></a>
        <a class="book-card" href="https://www.abebooks.com/9798190653625/Borax-Home-Garden-Handbook-Natural/plp" target="_blank" rel="noopener noreferrer"><div class="book-cover borax-book"><span>Independent guide</span><strong>The Borax<br/>Home &amp; Garden<br/>Handbook</strong><small>Miles C. Foster</small></div><div><p class="eyebrow">Reader reference</p><h3>The Borax Home &amp; Garden Handbook</h3><p>A practical, independently published guide. Because its core ingredient has documented hazards, do not treat “natural” as a safety claim; follow EPA and label guidance.</p><span>View the listing →</span></div></a>
        <a class="book-card" href="https://www.homesandgardens.com/solved/cleaning-books" target="_blank" rel="noopener noreferrer"><div class="book-cover reading-list"><span>Editorial roundup</span><strong>More naturally<br/>clean home<br/>reading</strong><small>Homes &amp; Gardens</small></div><div><p class="eyebrow">Further reading</p><h3>Five cleaning books to explore</h3><p>An editorial list covering Castile soap, whole-home routines, and simple ingredients. Retail links on the publisher’s page may be affiliate links.</p><span>Browse the reading list →</span></div></a>
      </div>
    </div>
  </section>

  <section class="container next-step"><div><p class="eyebrow">Your next practical step</p><h2>Remove one scent source today.</h2><p>Start with the product that adds fragrance to the air continuously—or the category you use most often.</p></div><a class="button" href={url('guides/reduce-fragrance-exposure/')}>Plan your first swaps ↗</a></section>
</Layout>

<style>
  .home-hero{padding:76px 0 64px;background:linear-gradient(135deg,#edf4ec 0%,#fbf9f6 54%,#f8e9dc 100%);border-bottom:1px solid var(--border)}
  .home-hero-grid{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(320px,.82fr);align-items:center;gap:68px}.home-hero h1{max-width:830px;margin:12px 0 24px;font-size:clamp(46px,6vw,82px);line-height:1.02;letter-spacing:-3.8px}.home-hero h1 em{font-family:Georgia,serif;font-weight:400;color:var(--accent-sage)}.home-hero .intro{max-width:700px}.home-illustration{position:relative;min-height:420px;overflow:hidden;border-radius:160px 160px 28px 28px;background:#dfeadd;box-shadow:0 18px 50px rgba(82,110,88,.14)}.home-illustration .sun{position:absolute;top:50px;right:54px;width:88px;height:88px;border-radius:50%;background:#f7c685}.home-illustration .house{position:absolute;left:68px;bottom:58px;width:240px;height:178px;border-radius:6px;background:#fffaf3;box-shadow:0 18px 30px rgba(51,51,51,.08)}.home-illustration .house:before{content:"";position:absolute;left:-26px;top:-95px;border-left:146px solid transparent;border-right:146px solid transparent;border-bottom:110px solid #7a9a8b}.home-illustration .house:after{content:"";position:absolute;left:87px;bottom:0;width:65px;height:103px;background:#f4a261}.home-illustration .house i{position:absolute;left:28px;top:48px;width:47px;height:49px;background:#e8f3f8;border:5px solid #fff;box-shadow:0 0 0 2px #d7e4e8}.home-illustration p{position:absolute;right:28px;bottom:28px;margin:0;color:#526e58;font-size:12px;line-height:1.55;letter-spacing:2px;writing-mode:vertical-rl;transform:rotate(180deg)}.home-illustration p strong{color:#333;font-size:15px}.leaf{position:absolute;width:32px;height:72px;border-radius:100% 0 100% 0;background:#89a67d;transform:rotate(-28deg)}.leaf-one{left:35px;bottom:42px}.leaf-two{right:96px;bottom:12px;transform:rotate(28deg) scale(.8)}
  .definition-note{margin-top:48px;padding:34px 38px;border:1px solid #dfe8dc;border-left:6px solid var(--accent-sage);border-radius:20px;background:#fff}.definition-note h2{margin:4px 0 14px;font-size:32px}.definition-note p:last-child{max-width:1000px;margin-bottom:0;color:var(--muted);line-height:1.8}.definition-note strong{color:var(--text)}
  .foundation-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}.foundation-grid article{padding:28px;border:1px solid var(--border);border-radius:20px;background:#fff}.foundation-grid article>span{display:grid;place-items:center;width:44px;height:44px;margin-bottom:30px;border-radius:50%;background:var(--accent-sky);color:#45636f;font-size:12px;font-weight:700}.foundation-grid h3{margin:0 0 12px;font-size:20px}.foundation-grid p{margin:0;color:var(--muted);font-size:14px;line-height:1.75}
  .safety-band{padding:68px 0;background:#293f39;color:#fff}.safety-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;align-items:start}.safety-band .eyebrow{color:#bcd1c4}.safety-band h2{margin:8px 0 0;font-size:clamp(34px,4vw,54px);line-height:1.12}.safety-grid>div:last-child{display:grid;gap:16px}.safety-grid p{margin:0;color:#dce7e1;line-height:1.8}.safety-grid strong{display:block;padding:18px 20px;border-radius:14px;background:#f7d5bd;color:#5a3320;line-height:1.6}
  .ingredient-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.ingredient-grid article{padding:30px;border:1px solid var(--border);border-radius:20px;background:#fff}.ingredient-role{margin:0 0 24px;color:var(--accent-sage);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.ingredient-grid h3{margin:0 0 12px;font-size:28px}.ingredient-grid article>p:not(.ingredient-role){color:var(--muted);line-height:1.75}.caution{display:flex;gap:16px;margin-top:22px;padding:16px;border-radius:12px;background:#fff5ec;color:#6d4734;font-size:13px;line-height:1.6}.caution strong{flex:none}.source-note{margin-top:24px;color:var(--muted);font-size:13px}
  .room-list{border-top:1px solid var(--border)}.room-list article{display:grid;grid-template-columns:70px 180px 1fr;gap:24px;align-items:start;padding:28px 0;border-bottom:1px solid var(--border)}.room-list article>span{color:var(--accent-sage);font-size:12px;font-weight:700}.room-list h3{margin:0;font-size:22px}.room-list p{margin:0;color:var(--muted);line-height:1.75}.room-actions{display:flex;align-items:center;gap:28px;margin-top:34px;flex-wrap:wrap}
  .reading-section{padding:78px 0;background:#f0ede7}.book-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.book-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(82,68,57,.12);border-radius:20px;background:#fff;color:var(--text);transition:transform .3s cubic-bezier(.34,1.56,.64,1),box-shadow .3s ease}.book-card:hover,.book-card:focus-visible{transform:translateY(-6px);box-shadow:0 12px 30px rgba(122,154,139,.16)}.book-cover{display:flex;flex-direction:column;justify-content:space-between;min-height:260px;padding:28px;background:#dfeadd}.book-cover>span{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.book-cover strong{font-family:Georgia,serif;font-size:36px;line-height:1.02;font-weight:400}.book-cover small{font-size:12px}.borax-book{background:#f1dfc7}.reading-list{background:#dcebf0}.book-card>div:last-child{display:flex;flex:1;flex-direction:column;padding:24px}.book-card h3{margin:0 0 12px;font-size:20px}.book-card p:not(.eyebrow){color:var(--muted);font-size:14px;line-height:1.7}.book-card div:last-child>span{margin-top:auto;color:var(--accent-sage);font-size:14px;font-weight:700}
  .next-step{display:flex;justify-content:space-between;align-items:center;gap:32px;margin-top:72px;margin-bottom:72px;padding:42px;border-radius:24px;background:#e8f3f8}.next-step h2{margin:6px 0 10px;font-size:36px}.next-step p:last-child{margin:0;color:var(--muted)}
  @media(max-width:1050px){.home-hero-grid{grid-template-columns:1fr}.home-illustration{min-height:330px}.foundation-grid{grid-template-columns:repeat(2,1fr)}.book-grid{grid-template-columns:1fr 1fr}.book-card:last-child{grid-column:1/-1}.safety-grid{gap:42px}}
  @media(max-width:700px){.home-hero{padding:50px 0}.home-hero h1{letter-spacing:-2px}.home-illustration{min-height:300px}.home-illustration .house{left:38px;transform:scale(.8);transform-origin:bottom left}.definition-note{padding:28px 24px}.foundation-grid,.ingredient-grid,.book-grid,.safety-grid{grid-template-columns:1fr}.book-card:last-child{grid-column:auto}.room-list article{grid-template-columns:45px 1fr}.room-list p{grid-column:2}.next-step{align-items:flex-start;flex-direction:column;padding:30px}.caution{flex-direction:column;gap:6px}}
</style>

