---
import Layout from '../layouts/Layout.astro';
import EditorialIcon from '../components/EditorialIcon.astro';
import {url} from '../lib/paths';
const stages=[
  {title:'Air care',icon:'air',items:['Pause plug-ins, room sprays, diffusers, incense, scented candles and wax melts.','Remove the source of an odour and ventilate when outdoor air and weather allow.']},
  {title:'Laundry & clothes',icon:'laundry',items:['Replace detergent with the exact fragrance-free version.','Stop scent beads, fragranced fabric softener and dryer sheets; review bedding and towels too.']},
  {title:'Household cleaning',icon:'cleaning',items:['Check floor, bathroom, kitchen and dishwashing products.','Use products as directed; never mix cleaners and store them securely.']},
  {title:'Skin & body',icon:'skin',items:['Review moisturiser, sunscreen and deodorant first, then hand wash and body wash.','Check current ingredients and any allergens you already know you need to avoid.']},
  {title:'Haircare',icon:'haircare',items:['Check shampoo, conditioner, styling sprays, oils and dry shampoo.','Choose the exact fragrance-free formula, not just a familiar brand.']},
  {title:'Bags & shared spaces',icon:'people',items:['Review hand cream, wipes, perfume and travel products.','Explain your changes and make one specific, practical request in shared spaces.']},
];
---
<Layout title="Printable fragrance-free starter checklist | CleanCare" description="Print or save a six-category fragrance-free checklist for room scents, laundry, household cleaning, body care, haircare and shared spaces." image={url('images/editorial/home-fragrance-free-swaps.webp')}>
<section class="container page-intro print-checklist"><p class="eyebrow">Keep beside your shopping list</p><h1>Your fragrance-free starter checklist.</h1><p class="intro">Choose one category at a time. This page needs no account or email. Use your browser’s print options to print it or save it as a PDF.</p><button class="button print-button" id="print-checklist" type="button">Print / save PDF ↓</button><p class="checklist-fields">Country: ____________________ &nbsp; Date: ____________________</p><div class="checklist-grid">{stages.map(stage=><article><h2><EditorialIcon name={stage.icon}/>{stage.title}</h2>{stage.items.map(item=><label><input type="checkbox"/><span>{item}</span></label>)}</article>)}</div><aside class="notice"><strong>Read labels, not slogans.</strong> Essential oils are fragrance ingredients. “Unscented,” “natural” and “hypoallergenic” do not necessarily mean fragrance-free. No product is guaranteed suitable for everyone. Do not change medically necessary products without appropriate professional advice. Never mix cleaners.</aside><p class="editorial-note">CleanCare · cleancare-fragrance-free.github.io · Educational checklist, not medical advice. Check current local formulas and product instructions.</p><div class="checklist-links"><a class="text-link" href={url('guides/fragrance-free-starter-toolkit/')}>Use the interactive toolkit →</a><a class="text-link" href={url('directory/')}>Find products by country →</a></div></section></Layout>
<script>document.querySelector('#print-checklist')!.addEventListener('click',()=>window.print());</script>
<style>.checklist-fields{padding-block:14px;font-size:13px}.checklist-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.checklist-grid article{padding:18px;border:1px solid var(--border);border-radius:16px;background:var(--card)}.checklist-grid h2{display:flex;align-items:center;gap:10px;font-size:19px;margin:0 0 12px}.checklist-grid label{display:flex;align-items:start;gap:10px;font-size:13px;line-height:1.6;margin-top:10px}.checklist-grid input{flex:none;width:18px;height:18px;margin-top:3px;accent-color:var(--accent-sage)}.checklist-links{display:flex;flex-wrap:wrap;gap:20px;margin-block:20px}.print-checklist .notice{margin-top:20px;font-size:12px;line-height:1.6}@media(max-width:700px){.checklist-grid{grid-template-columns:1fr}}@media print{.page-intro h1{font-size:28px}.page-intro .intro{font-size:11px}.checklist-grid{grid-template-columns:1fr 1fr;gap:8px}.checklist-grid article{padding:12px}.checklist-grid h2{font-size:16px}.checklist-grid label{font-size:11px}.checklist-links{display:none}.print-checklist .notice{font-size:10px}}</style>
