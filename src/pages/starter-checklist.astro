---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
const destination = url('guides/fragrance-free-starter-toolkit/#quick-checklist');
---
<Layout title="Checklist moved | CleanCare" description="The printable fragrance-free checklist is now part of the starter toolkit." noindex={true}>
  <section class="container page-intro moved-checklist">
    <p class="eyebrow">Page combined</p>
    <h1>The printable checklist and interactive toolkit are now together.</h1>
    <p class="intro">This saved page has moved. Open the combined page for a printable checklist first, followed by the interactive, country-aware starter toolkit.</p>
    <a class="button" href={destination}>Open the checklist + toolkit →</a>
  </section>
</Layout>
<script define:vars={{ destination }}>window.location.replace(destination);</script>
<style>.moved-checklist{padding-block:44px}.moved-checklist .button{margin-top:12px}</style>
