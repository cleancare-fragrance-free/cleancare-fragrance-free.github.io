---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/product-catalog.mjs';
import { assertProductCatalog } from '../lib/product-policy.mjs';
import { defaultScentFilter, matchesScentProfile, scentOptions } from '../lib/scent-profile.mjs';
import { countries, regions } from '../data/countries.mjs';
import { url } from '../lib/paths';
assertProductCatalog(products);
const initialProducts = products.filter(p => matchesScentProfile(p, defaultScentFilter));
---
<Layout title="Fragrance-free products by country | CleanCare">
<section class="container section directory">
  <p class="eyebrow">Practical alternatives</p>
  <h1>Fragrance-free options by country.</h1>
  <p class="intro">Fragrance may irritate sensitive skin or overwhelm a sensitive nose—and essential oils can trigger reactions too. Replace products one category at a time, from face care to laundry. Use the filters to distinguish products without added fragrance or essential oils from scented alternatives. Fragrance-free does not always mean odorless.</p>
  <p class="editorial-note">US additions inspired by <a href="https://nymag.com/strategist/article/fragrance-free-products-we-use.html" rel="external">The Strategist’s product roundup</a>, checked against official brand information. Product links are not affiliate links.</p>
  <p class="scent-notice"><strong>Fragrance-free is the default.</strong> Essential-oil products appear only when you select their filter or “All options.” They are scented, not fragrance-free or automatically safer. <a href={url('guides/unscented-vs-fragrance-free/')}>Understand the labels →</a></p>
  <details class="directory-review"><summary>How we check products and country listings</summary>
    <p>We check exact versions, not whole brands. Products with added perfume/parfum or unconfirmed fragrance-free formulas are excluded. Essential-oil alternatives are separately reviewed and clearly labelled; they never appear in the default fragrance-free results.</p>
    <p>“No added fragrance or essential oils” means none are listed in the reviewed formula or an explicit brand statement confirms their absence—not laboratory-certified zero scent. Carrier oils are not essential oils. An unchecked essential-oil status is not evidence of absence; those products do not appear in the stricter filter. Devices have no product formula and are excluded from ingredient-based filters.</p>
    <p>Country sources do not guarantee stock, delivery or an unchanged local formula. Manufacturer claims are not independent safety assessments. Check your current packaging. Ecostore’s catalogue includes scented products; only the six checked Ultra Sensitive home products are included here.</p>
  </details>
  <div class="location-picker">
    <div role="group" aria-label="Choose a region" class="region-buttons"><button type="button" data-region-button="" aria-pressed="true">All regions</button>{regions.map(region => <button type="button" data-region-button={region.code} aria-pressed="false">{region.name}</button>)}</div>
    <p class="eyebrow">Choose a country</p>
    <div role="group" aria-label="Choose a country" class="country-buttons"><button type="button" data-country-button="" aria-pressed="true">All countries</button>{countries.map(country => <button type="button" data-country-button={country.code} data-parent-region={country.region} aria-pressed="false">{country.name}</button>)}</div>
  </div>
  <form id="filters" class="filters" role="search">
    <label class="search-label">Search the directory<input name="q" id="search" type="search" placeholder="Try laundry, cleanser, sunscreen or dye-free…"/></label>
    <label>Category<select name="category" id="category"><option value="">All categories</option><option value="Skin & Body">Skincare &amp; Body</option><option value="Home & Laundry">Cleaning &amp; Laundry</option><option>Haircare</option><option>Oral Care</option><option>Devices</option></select></label>
    <label>Essential oils &amp; scent<select name="scent" id="scent" aria-describedby="scent-help">{scentOptions.map(option => <option value={option.value} selected={option.value === defaultScentFilter}>{option.label}</option>)}</select></label>
    <button type="reset" class="reset">Reset filters</button>
  </form>
  <p id="scent-help" class="editorial-note">Fragrance-free claims do not automatically establish essential-oil absence. Use the stricter filter for separately checked formulas; ingredients can still have their own smell.</p>
  <noscript><p class="notice">JavaScript is needed to use the filters. Fragrance-free profiles are displayed below. The separate <a href={url('products/real-purity-roll-on-essential-oils-us/')}>essential-oil deodorant profile</a> is available directly, but is not fragrance-free.</p></noscript>
  <p id="result-count" role="status" aria-live="polite">{initialProducts.length} product profiles</p>
  <div id="products">{countries.filter(country => products.some(product => Object.hasOwn(product.countries, country.code))).map(country => <section class="country-group" data-country={country.code} aria-labelledby={'country-' + country.code}>
    <h2 id={'country-' + country.code}>{country.name}</h2><p class="editorial-note">Sources for this country. Check current stock, delivery, and local packaging with the brand.</p>
    <div class="product-grid">{products.filter(product => Object.hasOwn(product.countries, country.code)).map(product => <ProductCard product={product} hidden={!matchesScentProfile(product, defaultScentFilter)}/>)}</div>
  </section>)}</div>
  <div id="empty" class="empty" hidden><h2>No matches just yet.</h2><p id="empty-message">Try a broader search or reset the filters. Some countries do not yet have listings.</p><button class="button" id="empty-reset">Reset filters</button></div>
</section>
</Layout>
<script>
import products from '../data/product-catalog.mjs';
import { countries, regions, countryInRegion } from '../data/countries.mjs';
import { matchesProduct } from '../lib/filter.mjs';
import { defaultScentFilter, normalizeScentFilter } from '../lib/scent-profile.mjs';
const form = document.querySelector<HTMLFormElement>('#filters')!;
const query = document.querySelector<HTMLInputElement>('#search')!;
const category = document.querySelector<HTMLSelectElement>('#category')!;
const scent = document.querySelector<HTMLSelectElement>('#scent')!;
const productById = new Map(products.map(product => [product.id, product]));
let selectedCountry = '';
let selectedRegion = '';
const regionButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-region-button]')];
const countryButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-country-button]')];
const groups = [...document.querySelectorAll<HTMLElement>('[data-country]')];
const cards = [...document.querySelectorAll<HTMLElement>('[data-product-id]')];
function readURL() {
  const params = new URLSearchParams(location.search);
  query.value = params.get('q') || '';
  category.value = [...category.options].some(option => option.value === params.get('category')) ? params.get('category')! : '';
  scent.value = normalizeScentFilter(params.get('scent'));
  selectedCountry = countries.some(c => c.code === params.get('country')) ? params.get('country')! : '';
  selectedRegion = regions.some(r => r.code === params.get('region')) ? params.get('region')! : '';
  if (selectedCountry && !countryInRegion(selectedCountry, selectedRegion)) selectedRegion = countries.find(c => c.code === selectedCountry)!.region;
}
function render(updateURL = true) {
  const state = { query: query.value, category: category.value, country: selectedCountry, scent: scent.value };
  regionButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.regionButton === selectedRegion)));
  countryButtons.forEach(button => { button.hidden = !!button.dataset.countryButton && !countryInRegion(button.dataset.countryButton, selectedRegion); button.setAttribute('aria-pressed', String(button.dataset.countryButton === selectedCountry)); });
  const visibleProducts = new Set<string>();
  cards.forEach(card => {
    const product = productById.get(card.dataset.productId!)!;
    const country = card.closest<HTMLElement>('[data-country]')!.dataset.country;
    card.hidden = !countryInRegion(country, selectedRegion) || !matchesProduct(product, state) || (!!state.country && country !== state.country);
    if (!card.hidden) visibleProducts.add(product.id);
  });
  groups.forEach(group => { group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-product-id]')].some(card => !card.hidden); });
  const noCountryListings = !products.some(product => Object.keys(product.countries).some(code => (!selectedCountry || code === selectedCountry) && countryInRegion(code, selectedRegion)));
  document.querySelector('#empty-message')!.textContent = noCountryListings ? 'No product sources have been checked for this selection yet. This does not mean fragrance-free products are unavailable there.' : 'No products match these filters. Try a broader search or reset the filters.';
  const count = visibleProducts.size;
  document.querySelector('#result-count')!.textContent = `${count} product profile${count === 1 ? '' : 's'}`;
  document.querySelector<HTMLElement>('#empty')!.hidden = count !== 0;
  document.querySelector('#scent-help')!.textContent = ['essential-oils', 'all'].includes(state.scent)
    ? 'This selection includes scented essential-oil alternatives. They are not fragrance-free or automatically safer and can still cause allergy or irritation.'
    : state.scent === 'no-essential-oils'
      ? 'Only separately checked formulas with no added fragrance or essential oils listed. This is not a guarantee of zero odor, no allergens or an unchanged formula.'
      : state.scent === 'not-reviewed'
        ? 'These products have a checked fragrance-free claim, but essential-oil absence has not yet been established. They are excluded from the stricter filter.'
        : 'Fragrance-free claims do not automatically establish essential-oil absence. Use the stricter filter for separately checked formulas; ingredients can still have their own smell.';
  if (updateURL) {
    const params = new URLSearchParams();
    if (state.query) params.set('q', state.query);
    if (state.category) params.set('category', state.category);
    if (state.country) params.set('country', state.country);
    if (selectedRegion) params.set('region', selectedRegion);
    if (state.scent !== defaultScentFilter) params.set('scent', state.scent);
    history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : ''));
  }
}
regionButtons.forEach(button => button.addEventListener('click', () => { selectedRegion = button.dataset.regionButton!; selectedCountry = ''; render(); }));
countryButtons.forEach(button => button.addEventListener('click', () => { selectedCountry = button.dataset.countryButton!; render(); }));
form.addEventListener('submit', event => event.preventDefault());
form.addEventListener('input', () => render());
form.addEventListener('change', () => render());
form.addEventListener('reset', () => { query.value = ''; category.value = ''; scent.value = defaultScentFilter; selectedCountry = ''; selectedRegion = ''; render(); });
document.querySelector('#empty-reset')!.addEventListener('click', () => form.reset());
window.addEventListener('popstate', () => { readURL(); render(false); });
readURL(); render(false);
</script>
<style>
.directory .intro { max-width: 970px; font-size: 15px; line-height: 1.75; }
.directory a:not(.button) { text-decoration: none; }
.scent-notice { background: var(--accent-sky, #E8F3F8); border-radius: 20px; padding: 14px 18px; font-size: 13px; margin: 18px 0; }
.directory-review { border-bottom: 1px solid #EFEBE4; padding: 8px 0 14px; font-size: 12px; color: #6B7280; }
.directory-review summary { color: #333; font-weight: 600; cursor: pointer; }
.directory .filters { display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,.8fr) minmax(0,1.25fr) auto; gap: 16px; }
.directory .filters label { min-width: 0; }
@media (max-width: 900px) { .directory .filters { grid-template-columns: repeat(2,minmax(0,1fr)); } .search-label { grid-column: 1 / -1; } .reset { grid-column: 1 / -1; justify-self: start; } }
@media (max-width: 560px) { .directory .filters { grid-template-columns: minmax(0,1fr); } }
</style>
