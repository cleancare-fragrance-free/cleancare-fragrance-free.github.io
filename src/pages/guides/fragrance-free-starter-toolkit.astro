---
import Layout from '../../layouts/Layout.astro';
import EditorialIcon from '../../components/EditorialIcon.astro';
import PrivateHealthCheck from '../../components/PrivateHealthCheck.astro';
import { availableCountries as countries } from '../../data/directory-markets.mjs';
import { url } from '../../lib/paths';

const steps = [
  { number:'01', title:'Stop adding scent to the air', category:'Air care', body:'Pause plug-ins, room sprays, diffusers, incense, scented candles and wax melts. Remove the source of an odour and ventilate instead of masking it.', action:'Read the indoor-air guide', href:url('guides/fragrance-and-indoor-air-chemistry/'), query:'' },
  { number:'02', title:'Reset the laundry routine', category:'Laundry', body:'Replace detergent first, then remove scent beads, fabric softener and fragranced dryer sheets. Residue in a washer may take several cycles to clear.', action:'Find laundry alternatives', href:url('directory/'), query:'category=Home+%26+Laundry&q=laundry' },
  { number:'03', title:'Simplify household cleaning', category:'Cleaning', body:'Start with the products used on large surfaces: floor, bathroom, kitchen and dishwashing. Never mix cleaners, and always follow the current safety label.', action:'Find cleaning alternatives', href:url('directory/'), query:'category=Home+%26+Laundry&q=cleaner' },
  { number:'04', title:'Replace leave-on skincare', category:'Skin & body', body:'Prioritise products that stay on the skin—moisturiser, sunscreen and deodorant—then move to rinse-off cleansers and body wash.', action:'Find skin and body options', href:url('directory/'), query:'category=Skin+%26+Body' },
  { number:'05', title:'Change hair products', category:'Haircare', body:'Check shampoo, conditioner, styling sprays, oils and dry shampoo. Choose the exact fragrance-free version; do not rely on the brand name alone.', action:'Find haircare options', href:url('directory/'), query:'category=Haircare' },
  { number:'06', title:'Check bags and shared spaces', category:'Maintenance', body:'Review perfume, hand cream, wipes and travel products. Tell household members what changed, and make one specific request in shared spaces.', action:'Plan a shared-space request', href:url('guides/shared-spaces/'), query:'' },
];
const printableStages = [
  {title:'Air care',icon:'air',items:['Pause plug-ins, room sprays, diffusers, incense, scented candles and wax melts.','Remove the source of an odour and ventilate when outdoor air and weather allow.']},
  {title:'Laundry & clothes',icon:'laundry',items:['Replace detergent with the exact fragrance-free version.','Stop scent beads, fragranced fabric softener and dryer sheets; review bedding and towels too.']},
  {title:'Household cleaning',icon:'cleaning',items:['Check floor, bathroom, kitchen and dishwashing products.','Use products as directed; never mix cleaners and store them securely.']},
  {title:'Skin & body',icon:'skin',items:['Review moisturiser, sunscreen and deodorant first, then hand wash and body wash.','Check current ingredients and any allergens you already know you need to avoid.']},
  {title:'Haircare',icon:'haircare',items:['Check shampoo, conditioner, styling sprays, oils and dry shampoo.','Choose the exact fragrance-free formula, not just a familiar brand.']},
  {title:'Bags & shared spaces',icon:'people',items:['Review hand cream, wipes, perfume and travel products.','Explain your changes and make one specific, practical request in shared spaces.']},
];
---
<Layout title="Fragrance-free starter checklist and toolkit | CleanCare" description="Print a quick fragrance-free checklist, then use the interactive, country-aware toolkit to plan and track product swaps by category.">
  <header class="container story-header toolkit-hero">
    <a class="text-link" href={url('guides/')}>← Articles &amp; guides</a>
    <p class="eyebrow">A practical replacement plan</p>
    <h1>Your fragrance-free <em>starter plan.</em></h1>
    <p class="intro">Use the private health check if helpful, then pick a category from the checklist. The country-aware interactive toolkit at the end helps you plan and track swaps.</p>
    <div class="notice"><strong>Start with what affects your air most:</strong> products designed to spread scent, then laundry and cleaners used across large surfaces. If a product is medically necessary, ask an appropriate health professional before changing it.</div>
  </header>

  <PrivateHealthCheck/>

  <section class="container quick-checklist" id="quick-checklist" aria-labelledby="quick-checklist-title">
    <div class="quick-checklist-heading"><div><p class="eyebrow">Keep beside your shopping list</p><h2 id="quick-checklist-title">A quick, printable checklist</h2><p>Choose one category at a time. No account or email is needed; use your browser’s print options to print or save this section as a PDF.</p></div><button class="button print-button" id="print-checklist" type="button">Print / save PDF ↓</button></div>
    <p class="checklist-fields">Country: ____________________ &nbsp; Date: ____________________</p>
    <div class="checklist-grid">{printableStages.map(stage=><article><h3><EditorialIcon name={stage.icon}/>{stage.title}</h3>{stage.items.map(item=><label><input type="checkbox"/><span>{item}</span></label>)}</article>)}</div>
    <aside class="notice checklist-notice"><strong>Read labels, not slogans.</strong> Essential oils are fragrance ingredients. “Unscented,” “natural” and “hypoallergenic” do not necessarily mean fragrance-free. No product is guaranteed suitable for everyone. Do not change medically necessary products without appropriate professional advice. Never mix cleaners.</aside>
    <nav class="checklist-links" aria-label="Related fragrance-free resources"><a class="text-link" href={url('directory/')}>Find products by country →</a><a class="text-link" href={url('evidence/')}>Review the evidence →</a></nav>
    <p class="editorial-note">CleanCare · Educational checklist, not medical advice. Check current local formulas and product instructions.</p>
  </section>

  <section class="container section toolkit" id="toolkit" data-toolkit aria-labelledby="toolkit-title">
    <div class="toolkit-page-heading"><p class="eyebrow">The interactive plan</p><h2 id="toolkit-title">Your fragrance-free starter toolkit</h2><p>Pick your shopping country, make progress one category at a time, and follow the links to compare exact products and practical guides.</p></div>
    <div class="toolkit-country">
      <div><p class="eyebrow">Step zero</p><h2>Where are you shopping?</h2><p>Country availability and formulas differ. Your choice is added to each directory link.</p></div>
      <label>Choose a country
        <select id="toolkit-country">
          <option value="">Show all checked countries</option>
          {countries.map(country => <option value={country.code}>{country.name}</option>)}
        </select>
      </label>
    </div>

    <div class="toolkit-progress" aria-live="polite"><div><span id="toolkit-count">0 of 6 stages complete</span><button id="toolkit-reset" class="text-link" type="button">Reset progress</button></div><progress id="toolkit-progress" max={steps.length} value="0">0%</progress></div>

    <ol class="toolkit-steps">
      {steps.map(step => <li class="toolkit-step" id={'toolkit-step-'+step.number}>
        <label class="toolkit-check"><input type="checkbox" data-toolkit-check={step.number}/><span class="visually-hidden">Mark {step.title} complete</span></label>
        <div class="toolkit-number"><span class="toolkit-icon"><EditorialIcon name={['air', 'laundry', 'cleaning', 'skin', 'haircare', 'bag'][Number(step.number) - 1]}/></span><span>{step.number}</span></div>
        <div class="toolkit-copy"><p class="eyebrow">{step.category}</p><h2>{step.title}</h2><p>{step.body}</p><a class="button toolkit-link" href={step.href} data-base-href={step.href} data-query={step.query}>{step.action} →</a></div>
      </li>)}
    </ol>
    <div class="context-next"><h2>One category is a good start.</h2><p>Save your progress in this browser, revisit the printable checklist above, or move on to the directory for checked options in your country.</p><a class="button" href={url('directory/')}>Browse fragrance-free products →</a></div>

    <section class="toolkit-labels">
      <div><p class="eyebrow">Keep beside your shopping list</p><h2>What to look for</h2></div>
      <div class="toolkit-label-grid"><article><h3>Prefer</h3><p>An explicit <strong>fragrance-free</strong> claim for the exact product, plus a current ingredient list.</p></article><article><h3>Double-check</h3><p>“Unscented,” “natural,” “clean,” “hypoallergenic,” and “for sensitive skin” do not necessarily mean no fragrance.</p></article><article><h3>Remember</h3><p>Essential oils are fragrance ingredients. Fragrance-free does not mean free from every possible allergen or irritant.</p></article></div>
    </section>
    <p class="editorial-note">Your checklist and country choice are stored only in this browser. CleanCare does not receive them. Product formulations and availability can change, so recheck the current label and official source before buying.</p>
  </section>
</Layout>

<script>
  const storageKey = 'cleancare-toolkit-v1';
  const countryKey = 'cleancare-toolkit-country';
  const checks = [...document.querySelectorAll<HTMLInputElement>('[data-toolkit-check]')];
  const country = document.querySelector<HTMLSelectElement>('#toolkit-country')!;
  const progress = document.querySelector<HTMLProgressElement>('#toolkit-progress')!;
  const count = document.querySelector<HTMLElement>('#toolkit-count')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toolkit-link')];
  function savedStages() { try { return JSON.parse(localStorage.getItem(storageKey) || '[]'); } catch { return []; } }
  function updateLinks() { for (const link of links) { const params = new URLSearchParams(link.dataset.query || ''); if (country.value) params.set('country', country.value); link.href = link.dataset.baseHref + (params.size ? `?${params}` : ''); } }
  function render() { const done = checks.filter(item => item.checked).length; progress.value = done; count.textContent = `${done} of ${checks.length} stages complete`; updateLinks(); }
  const saved = new Set(savedStages());
  checks.forEach(item => { item.checked = saved.has(item.dataset.toolkitCheck); item.addEventListener('change', () => { localStorage.setItem(storageKey, JSON.stringify(checks.filter(box => box.checked).map(box => box.dataset.toolkitCheck))); render(); }); });
  country.value = localStorage.getItem(countryKey) || '';
  country.addEventListener('change', () => { localStorage.setItem(countryKey, country.value); render(); });
  document.querySelector('#toolkit-reset')!.addEventListener('click', () => { checks.forEach(item => item.checked = false); localStorage.removeItem(storageKey); render(); });
  document.querySelector('#print-checklist')!.addEventListener('click', () => window.print());
  render();
</script>

<style>
  .toolkit-hero { padding-top:24px; padding-bottom:0; }
  .toolkit-hero>.eyebrow { margin-top:22px; }
  .toolkit-hero h1 { max-width:820px; margin:8px 0 12px; font-size:clamp(32px,3.6vw,44px); line-height:1.12; }
  .toolkit-hero>.intro { max-width:900px; margin-bottom:12px; font-size:13px; line-height:1.6; }
  .toolkit-hero>.notice { max-width:960px; margin:12px 0 8px; padding:12px 16px; font-size:12px; line-height:1.6; }
  .quick-checklist{padding-block:18px 30px}.quick-checklist-heading{display:flex;align-items:end;justify-content:space-between;gap:20px}.quick-checklist-heading h2,.toolkit-page-heading h2{margin:4px 0 6px;font-size:24px}.quick-checklist-heading p:not(.eyebrow),.toolkit-page-heading>p:last-child{max-width:760px;margin:0;color:var(--muted);font-size:12px;line-height:1.6}.quick-checklist-heading .button{flex:none;min-height:42px;padding:9px 14px;font-size:12px}.checklist-fields{padding-block:10px;margin:0;font-size:12px}.checklist-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.checklist-grid article{padding:13px;border:1px solid var(--border);border-radius:15px;background:#fff}.checklist-grid h3{display:flex;align-items:center;gap:8px;margin:0 0 8px;font-size:14px}.checklist-grid h3 .editorial-icon{width:18px;height:18px}.checklist-grid label{display:flex;align-items:start;gap:8px;margin-top:7px;font-size:11px;line-height:1.5}.checklist-grid input{flex:none;width:16px;height:16px;margin:2px 0 0;accent-color:var(--accent-sage)}.checklist-notice{margin:12px 0 0;padding:10px 13px;font-size:11px;line-height:1.55}.checklist-links{display:flex;flex-wrap:wrap;gap:18px;margin-top:12px;font-size:12px}.quick-checklist>.editorial-note{margin:10px 0 0;font-size:10px}.toolkit-page-heading{margin-bottom:16px}.toolkit-page-heading .eyebrow{margin:0}
  .toolkit.section { padding-block:18px 48px; }
  .toolkit-country { display:grid; grid-template-columns:1.4fr .8fr; gap:16px; align-items:end; padding:16px; border:1px solid var(--border); border-radius:var(--radius-card); background:var(--accent-sky); }
  .toolkit-country h2,.toolkit-labels h2 { margin:4px 0 8px; font-size:22px; }
  .toolkit-country p { margin-bottom:0; color:var(--muted); font-size:12px; line-height:1.6; }
  .toolkit-country label { display:grid; gap:9px; font-size:12px; font-weight:700; }
  .toolkit-country select { width:100%; min-height:48px; border:1px solid var(--border); border-radius:12px; background:#fff; padding:10px 14px; }
  .toolkit-progress { margin:14px 0; }
  .toolkit-progress div { display:flex; justify-content:space-between; gap:20px; align-items:center; margin-bottom:10px; font-size:13px; font-weight:700; }
  .toolkit-progress progress { width:100%; height:8px; accent-color:var(--accent-sage); }
  .toolkit-progress button { border:0; background:none; padding:8px; min-height:44px; }
  .toolkit-steps { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:0; padding:0; list-style:none; }
  .toolkit-step { position:relative; display:grid; grid-template-columns:38px minmax(0,1fr); gap:12px; align-items:start; padding:16px; border:1px solid var(--border); border-radius:20px; background:var(--card); }
  .toolkit-step {scroll-margin-top:24px}
  .toolkit-check { position:absolute; top:6px; right:6px; display:grid; place-items:center; width:44px; height:44px; cursor:pointer; }
  .toolkit-check input { width:22px; height:22px; accent-color:var(--accent-sage); }
  .toolkit-number { display:grid; justify-items:center; gap:5px; color:var(--accent-sage); font-size:10px; font-weight:700; letter-spacing:.1em; }
  .toolkit-icon { display:grid; place-items:center; width:38px; height:38px; border-radius:12px; background:var(--accent-sky); }
  .toolkit-copy>.eyebrow { margin:0 32px 4px 0; font-size:9px; }
  .toolkit-copy h2 { margin:1px 28px 7px 0; font-size:18px; line-height:1.35; }
  .toolkit-copy>p:not(.eyebrow) { margin:0; color:var(--muted); font-size:13px; line-height:1.55; }
  .toolkit-link { display:inline-flex; margin-top:10px; padding:8px 12px; min-height:44px; font-size:11px; }
  .toolkit-labels { margin-top:24px; padding:18px; border-radius:var(--radius-card); background:#eef3ed; }
  .toolkit-label-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-top:12px; }
  .toolkit-label-grid article { padding:12px; border-radius:16px; background:#fff; }
  .toolkit-label-grid h3 { margin:0 0 6px; font-size:15px; }
  .toolkit-label-grid p { margin-bottom:0; color:var(--muted); font-size:12px; line-height:1.6; }
  @media(max-width:850px) { .toolkit-steps { grid-template-columns:1fr; } }
  @media(max-width:760px) {
    .quick-checklist{padding-block:14px 22px}.quick-checklist-heading{align-items:flex-start;flex-direction:column;gap:10px}.quick-checklist-heading h2{font-size:21px}.checklist-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.checklist-links{gap:12px}
    .toolkit-country,.toolkit-label-grid { grid-template-columns:1fr; }
    .toolkit-country { gap:14px; }
    .toolkit-step { padding:14px; }
    /* Keep the action compact without shrinking its comfortable tap target. */
    .toolkit-link,.toolkit .context-next .button {
      min-height:40px;
      gap:8px;
      padding:9px 13px;
      border-color:#edb98f;
      background:#f8d1b0;
      color:#4b382c;
      font-size:12px;
      line-height:1.25;
      box-shadow:none;
    }
    .toolkit-link:hover,.toolkit-link:focus-visible,.toolkit .context-next .button:hover,.toolkit .context-next .button:focus-visible {
      background:#f4c294;
      box-shadow:none;
    }
  }
  @media(max-width:520px){.checklist-grid{grid-template-columns:1fr}.checklist-grid article{padding:12px}.checklist-fields{font-size:11px}}
  @media print{@page{margin:14mm}body *{visibility:hidden!important}.quick-checklist,.quick-checklist *{visibility:visible!important}.quick-checklist{position:absolute;inset:0 auto auto 0;width:100%;max-width:none;padding:0}.quick-checklist-heading .button,.checklist-links{display:none!important}.checklist-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.checklist-grid article{padding:10px;break-inside:avoid}.checklist-grid h3{font-size:12px}.checklist-grid label{font-size:9px}.checklist-notice{font-size:9px}.quick-checklist>.editorial-note{font-size:8px}}
</style>
