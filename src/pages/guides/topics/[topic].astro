---
import Layout from '../../../layouts/Layout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import EditorialIcon from '../../../components/EditorialIcon.astro';
import {guideTopics} from '../../../data/guide-topics.mjs';
import {articles} from '../../../data/articles.mjs';
import {url} from '../../../lib/paths';
export function getStaticPaths(){return guideTopics.map(topic=>({params:{topic:topic.slug},props:{topic}}));}
const {topic}=Astro.props;
const guides=topic.slugs.map(slug=>articles.find(article=>article.slug===slug));
---
<Layout title={`${topic.title} — fragrance-free guides | CleanCare`} description={topic.description+' Read source-led explanations and practical next steps, with evidence limits in view.'} lang={topic.language || 'en'} image={url('images/editorial/'+(topic.slug==='indoor-air'?'home-cleaner-air-habits.webp':'home-fragrance-free-swaps.webp'))}><section class="container page-intro"><p class="eyebrow"><EditorialIcon name={topic.icon}/> Topic guide</p><h1>{topic.title}.</h1><p class="intro">{topic.description}</p><p class="editorial-note">Start with the question closest to your needs. These educational articles distinguish documented concerns from opinion and individual experience; they are not medical advice.</p><div class="journal-grid">{guides.map(article=><ArticleCard article={article}/>)}</div><section class="context-next"><h2>Keep the original sources in view.</h2><a class="text-link" href={url('evidence/')}>Explore the evidence library →</a></section><nav class="topic-nav" aria-label="Other guide topics">{guideTopics.filter(item=>item.slug!==topic.slug).map(item=><a href={url('guides/topics/'+item.slug+'/')}>{item.title} →</a>)}</nav></section></Layout>
<style>.topic-nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}.topic-nav a{font-size:13px;color:var(--link-color);padding:12px;background:var(--card);border-radius:999px;border:1px solid var(--border)}</style>
