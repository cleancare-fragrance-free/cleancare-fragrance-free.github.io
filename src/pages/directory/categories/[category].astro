---
import Layout from '../../../layouts/Layout.astro';
import ProductCollection from '../../../components/ProductCollection.astro';
import products from '../../../data/product-catalog.mjs';
import {productCategories,availableCountries} from '../../../data/directory-markets.mjs';
import {url} from '../../../lib/paths';
export function getStaticPaths(){return productCategories.map(category=>({params:{category:category.slug},props:{category}}));}
const {category}=Astro.props;
const matches=products.filter(product=>product.category===category.category&&product.fragranceStatus==='fragrance-free');
const countries=availableCountries.filter(country=>matches.some(product=>Object.hasOwn(product.countries,country.code)));
---
<Layout title={`Fragrance-free ${category.title.toLowerCase()} products | CleanCare`} description={`Compare exact fragrance-free ${category.title.toLowerCase()} versions by country. Each profile links to brand information and ingredient caveats.`} image={url('images/editorial/home-fragrance-free-swaps.webp')}><section class="container page-intro"><p class="eyebrow">Browse by routine</p><h1>Fragrance-free {category.title.toLowerCase()}.</h1><p class="intro">Choose a checked country before comparing products. These are source-checked notes, not independent certification or a guarantee of suitability. Essential-oil alternatives are not included on this page.</p><nav class="category-countries" aria-label="Choose a country for this category">{countries.map(country=><a class="button" href={url('directory/')+'?'+new URLSearchParams({country:country.code,category:category.category})}>{country.name} →</a>)}</nav><p class="editorial-note">Fragrance-free does not mean odorless or allergen-free. Recheck the current local ingredients. <a href={url('guides/unscented-vs-fragrance-free/')}>Read the label guide →</a></p><ProductCollection products={matches} id={'category-'+category.slug}/><section class="context-next"><h2>Replace one category at a time.</h2><a class="text-link" href={url('guides/fragrance-free-starter-toolkit/')}>Use the practical starter toolkit →</a></section></section></Layout>
<style>.category-countries{display:flex;flex-wrap:wrap;gap:10px;margin-block:20px}.category-countries a{font-size:13px}</style>
