---
import Layout from '../layouts/Layout.astro';
import { celebrityStories } from '../data/celebrity-stories.mjs';
import { url } from '../lib/paths';
---
<Layout title="Celebrity stories: fragrance-free choices & ingredient transparency | CleanCare" description="Eight compact, source-linked celebrity stories about fragrance-free options, ingredient disclosure and cosmetics reform—with important distinctions.">
  <section class="container section celebrity-page">
    <p class="eyebrow">Celebrity stories · people behind the conversation</p>
    <h1>Celebrity stories: fragrance-free choices &amp; transparency.</h1>
    <p class="intro">Meet the founders and voices opening up the conversation about scent, sensitive skin and ingredient disclosure.</p>
    <p class="notice">Different stories, different choices. Offering a fragrance-free product—or disclosing perfume ingredients—does not mean someone avoids all fragrance. These stories are not medical advice or brand endorsements.</p>
    <div class="celebrity-mosaic">
      {celebrityStories.map((person, index) => <article class="celebrity-tile">
        <a class="celebrity-story-link" href={person.source} target="_blank" rel="noopener noreferrer" aria-labelledby={`celebrity-${index}`}>
          <div class="celebrity-image"><img src={person.local ? url(person.image) : person.image} alt={person.name} loading="lazy" decoding="async" width="600" height="440" referrerpolicy="no-referrer"/></div>
          <div class="celebrity-copy">
            <span class="celebrity-category">{person.category}</span>
            <h2 id={`celebrity-${index}`}>{person.name}</h2>
            <p>{person.text}</p>
            <span class="text-link">Explore the source ↗</span>
            <small>{person.publisher}</small>
          </div>
        </a>
        <small class="image-credit">Image: {person.imageSource ? <a href={person.imageSource} target="_blank" rel="noopener noreferrer">{person.credit}</a> : person.credit}{person.licenseUrl && <> · <a href={person.licenseUrl} target="_blank" rel="noopener noreferrer">{person.license}</a> · cropped</>}</small>
      </article>)}
    </div>
    <div class="story-context">
      <details open>
        <summary>Why ingredient transparency matters</summary>
        <p>In the US, cosmetic labels can list a scent mixture as “fragrance” without naming each component. The <a href="https://www.fda.gov/cosmetics/cosmetic-ingredients/fragrances-cosmetics">FDA explains this labeling rule</a>. It can make identifying a personal trigger harder—but the word itself does not prove a product contains a particular harmful chemical.</p>
      </details>
      <details>
        <summary>The scientific context: sensitivity is individual</summary>
        <p>Fragrance can cause contact allergy and may trigger respiratory symptoms in susceptible people. “Natural” essential oils can also contain allergens. <a href="https://www.fda.gov/cosmetics/cosmetic-ingredients/allergens-cosmetics">Read the FDA’s guidance on cosmetic allergens</a>.</p>
        <p>Long-term or hormonal effects require ingredient-specific evidence and an assessment of dose and exposure—not a blanket conclusion from a celebrity story. Explore our <a href={url('guides/vocs-and-endocrine-disruptors/')}>VOCs and endocrine disruptors guide</a> and <a href={url('evidence/')}>evidence library</a>.</p>
      </details>
      <details>
        <summary>Continue the conversation</summary>
        <p>These discovery links may require sign-in; they are not verified health evidence.</p>
        <ul><li><a href="https://www.tiktok.com/discover/celebrities-who-doesnt-wear-fragrances">TikTok celebrity discovery feed ↗</a></li><li><a href="https://www.instagram.com/reel/DSGwsz9juVP/">First shared Instagram reel ↗</a></li><li><a href="https://www.instagram.com/reel/DWXCJPwDdp_/">Second shared Instagram reel ↗</a></li></ul>
      </details>
    </div>
    <p class="editorial-note">Sources checked October 2026. Brand formulations can change. Images remain owned by their creators; image credits link to the original source or license.</p>
  </section>
</Layout>
<style>
  .celebrity-page{padding-block:36px}
  .celebrity-page h1{font-size:clamp(28px,3vw,38px);max-width:1100px;line-height:1.15;margin-bottom:12px}
  .celebrity-page .intro{max-width:950px;font-size:14px;line-height:1.6;margin-bottom:12px}
  .celebrity-page .notice{font-size:13px;line-height:1.6;padding:14px 18px}
  .celebrity-mosaic{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-block:24px}
  .celebrity-tile{min-width:0;border:1px solid var(--border);border-radius:20px;overflow:hidden;background:var(--card);display:flex;flex-direction:column;transition:transform .25s,box-shadow .25s}
  .celebrity-tile:has(a:is(:hover,:focus-visible)){transform:translateY(-4px);box-shadow:0 12px 30px #7a9a8b20}
  .celebrity-story-link{display:flex;flex-direction:column;flex:1;color:var(--text);text-decoration:none}
  .celebrity-story-link:focus-visible{outline:3px solid var(--accent-sage);outline-offset:-3px}
  .celebrity-image{height:160px;overflow:hidden;background:var(--accent-sky)}
  .celebrity-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center 25%;transition:transform .3s ease}
  .celebrity-story-link:hover img{transform:scale(1.03)}
  .celebrity-copy{padding:14px 16px 8px;display:flex;flex-direction:column;flex:1}
  .celebrity-category{align-self:flex-start;background:var(--accent-sky);border-radius:999px;padding:4px 8px;font-size:10px;line-height:1.4;font-weight:600}
  .celebrity-copy h2{font-size:19px;line-height:1.25;margin:10px 0 8px;letter-spacing:-.4px}
  .celebrity-copy p{font-size:12px;line-height:1.65;color:var(--muted);margin:0 0 12px}
  .celebrity-copy .text-link{font-size:12px;margin-top:auto;color:var(--accent-sage);font-weight:700}
  .celebrity-story-link:hover .text-link{color:var(--accent-active)}
  .celebrity-copy small,.image-credit{display:block;font-size:10px;line-height:1.5;color:var(--muted)}
  .celebrity-copy small{margin-top:7px}
  .image-credit{padding:0 16px 14px;margin:0}
  .image-credit a{color:inherit;text-decoration:none}
  .image-credit a:hover{text-decoration:underline}
  .story-context{border:1px solid var(--border);border-radius:20px;background:var(--accent-sky);padding:6px 20px}
  .story-context details{padding:14px 0}
  .story-context details+details{border-top:1px solid #d5e1e4}
  .story-context summary{cursor:pointer;font-size:15px;font-weight:600}
  .story-context p,.story-context li{font-size:13px;line-height:1.7;max-width:950px}
  .story-context p{margin:12px 0 0}
  .story-context a{font-weight:600}
  @media(max-width:1050px){.celebrity-mosaic{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:760px){.celebrity-mosaic{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.celebrity-image{height:140px}.celebrity-copy{padding:12px 12px 8px}.celebrity-copy h2{font-size:17px}.image-credit{padding:0 12px 12px}.celebrity-page h1{font-size:30px}}
  @media(max-width:360px){.celebrity-mosaic{grid-template-columns:1fr}.celebrity-image{height:170px}}
  @media(prefers-reduced-motion:reduce){.celebrity-tile,.celebrity-image img{transition:none}.celebrity-tile:has(a:is(:hover,:focus-visible)),.celebrity-story-link:hover img{transform:none}}
</style>
