---
import DoctorBadge from './DoctorBadge.astro';
import { url } from '../lib/paths';
const { video, compact = false } = Astro.props;
const href = video.local ? url(video.href) : video.href;
---
<a class:list={['video-card', {'video-card--compact': compact}]} href={href} target={video.local ? undefined : '_blank'} rel={video.local ? undefined : 'noopener noreferrer'}>
  <div class="video-card-image">
    <img src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`} alt={`Video thumbnail for ${video.title}`} width="480" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>
    {video.doctor && <div class="video-doctor"><DoctorBadge compact={compact}/></div>}
    <span class="video-play" aria-hidden="true">▶</span>
  </div>
  <div class="video-card-copy">
    <p class="eyebrow">{video.source}</p>
    <h3>{video.title}</h3>
    <p>{video.note}</p>
    <span class="journal-card-link">{video.local ? 'Explore the film' : 'Watch on YouTube'} →</span>
  </div>
</a>

<style>
  .video-doctor { position:absolute;top:14px;left:14px; }
  .video-card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid var(--border); border-radius:var(--radius-card); background:var(--card); color:var(--text); transition:transform .3s cubic-bezier(.34,1.56,.64,1),box-shadow .3s ease; }
  .video-card:hover,.video-card:focus-visible { transform:translateY(-6px); box-shadow:0 12px 30px rgba(122,154,139,.12); }
  .video-card-image { position:relative; height:210px; overflow:hidden; background:var(--accent-sky); }
  .video-card-image img { width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
  .video-card:hover img,.video-card:focus-visible img { transform:scale(1.04); }
  .video-play { position:absolute; inset:50% auto auto 50%; translate:-50% -50%; display:grid; place-items:center; width:58px; height:58px; border-radius:50%; background:rgba(255,255,255,.94); color:var(--accent-active); box-shadow:0 8px 24px rgba(51,51,51,.18); padding-left:4px; }
  .video-card-copy { display:flex; flex:1; flex-direction:column; padding:24px; }
  .video-card-copy h3 { margin:0 0 12px; font-size:21px; line-height:1.35; }
  .video-card-copy p:not(.eyebrow) { color:var(--muted); font-size:14px; line-height:1.75; }
  .journal-card-link { margin-top:auto; color:var(--link-color,#435e52); font-size:14px; font-weight:700; }
  .video-card:hover .journal-card-link { color:var(--link-hover,#8b4c20); }
  @media (prefers-reduced-motion:reduce) { .video-card,.video-card-image img { transition:none; } .video-card:hover,.video-card:focus-visible,.video-card:hover img,.video-card:focus-visible img { transform:none; } }
</style>
<style>
.video-card--compact .video-card-image { height:128px; }
.video-card--compact .video-card-copy { padding:14px; }
.video-card--compact .video-card-copy h3 { font-size:17px;line-height:1.35;margin-bottom:8px; }
.video-card--compact .video-card-copy p:not(.eyebrow) { font-size:13px;line-height:1.6;margin:0 0 12px; }
.video-card--compact .video-card-copy .eyebrow { font-size:11px;line-height:1.5;margin-bottom:7px; }
.video-card--compact .video-play { width:36px;height:36px;font-size:12px; }
.video-card--compact .video-doctor { top:8px;left:8px; }
.video-card--compact .journal-card-link { font-size:13px; }
</style>
