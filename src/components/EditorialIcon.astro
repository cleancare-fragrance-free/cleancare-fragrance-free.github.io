---
const { name = 'book' } = Astro.props;
const paths = {
 book: 'M12 6c-3-2-6-2-9-1v14c3-1 6-1 9 1m0-14c3-2 6-2 9-1v14c-3-1-6-1-9 1V6',
 air: 'M3 8h12a3 3 0 1 0-3-3M3 12h15a3 3 0 1 1-3 3M3 16h5',
 home: 'm3 11 9-8 9 8M5 10v11h14V10M9 21v-7h6v7',
 heart: 'M12 21 4 13C-2 6 7 0 12 7c5-7 14-1 8 6l-8 8',
};
---
<svg class="editorial-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={paths[name] || paths.book} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
<style>.editorial-icon{display:inline-block;width:24px;height:24px;flex-shrink:0;color:#526e58;vertical-align:middle}</style>
