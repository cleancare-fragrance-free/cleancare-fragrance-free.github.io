---
import { url } from '../lib/paths';
const rooms = [
  { id: 'laundry', icon: '☀', title: 'Laundry', text: 'Start with the extras: softener, scent beads and dryer sheets. Then compare a fragrance-free detergent.', href: 'guides/fragrance-free-laundry/', link: 'Reset your laundry routine' },
  { id: 'bathroom', icon: '◌', title: 'Bathroom', text: 'Check everyday cleansers, moisturisers and haircare. Read the ingredients—not just “gentle” on the label.', href: 'directory/?category=Skin%20%26%20Body', link: 'Explore skin and body options' },
  { id: 'living', icon: '⌂', title: 'Living spaces', text: 'Remove optional scent sources such as air fresheners, incense and scented candles. Address the cause of odours.', href: 'non-toxic-home/', link: 'Build a simpler home routine' },
];
---
<section class="container room-guide" aria-labelledby="room-title">
  <div><p class="eyebrow">One room. One manageable change.</p><h2 id="room-title">A cleaner home starts here.</h2><p>Explore a starting point, then follow the full guide.</p></div>
  <div class="room-browser"><div class="room-controls" aria-label="Choose a room">{rooms.map((room,index) => <button type="button" data-room={room.id} aria-pressed={index === 0} aria-controls={'room-' + room.id}><span aria-hidden="true">{room.icon}</span>{room.title}</button>)}</div>
    {rooms.map(room => <div class="room-panel" id={'room-' + room.id}><span class="eyebrow">{room.title}</span><h3>{room.link}</h3><p>{room.text}</p><a class="text-link" href={url(room.href)}>Explore the guide →</a></div>)}
  </div>
</section>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-room]')];
  const selectRoom = (id: string) => {
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.room === id)));
    document.querySelectorAll<HTMLElement>('.room-panel').forEach(panel => panel.hidden = panel.id !== 'room-' + id);
  };
  buttons.forEach(button => button.addEventListener('click', () => selectRoom(button.dataset.room!)));
  if (buttons.length) selectRoom(buttons[0].dataset.room!);
</script>
<style>
  .room-guide{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;align-items:center;margin-block:48px;padding:36px;border-radius:20px;background:#e8eee7}
  h2{font-size:clamp(28px,3vw,40px);margin:12px 0}.room-guide p{color:#536158;font-size:14px;line-height:1.8}.room-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}.room-controls button{padding:12px 16px;border:1px solid #cad7cb;background:transparent;color:var(--text);font-weight:600;font-size:12px;min-height:44px}.room-controls span{margin-right:8px}.room-controls button[aria-pressed=true]{background:#fff;border-color:#fff;box-shadow:0 4px 14px #526e5810}.room-panel{padding:24px;background:white;border-radius:20px;margin-top:12px}.room-panel h3{font-size:22px;margin:8px 0}.room-panel .text-link{display:inline-block;margin-top:8px}
  @media(max-width:720px){.room-guide{grid-template-columns:1fr;gap:20px;padding:24px}.room-controls button{padding:10px 13px}}
</style>
