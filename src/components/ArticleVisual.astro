---
const { kind = 'research', label = 'Editorial illustration' } = Astro.props;
const colors = { research: '#e4e8dc', air: '#dfeceb', home: '#eadfcd', labels: '#eadfd9', laundry: '#e0e8ed', shared: '#e8e4ef' };
---
<svg class="article-visual" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="500" fill={colors[kind] || colors.research}/><circle cx="660" cy="110" r="145" fill="#fff" opacity=".24"/><path d="M0 415Q280 325 800 405V500H0Z" fill="#304f42" opacity=".07"/>
  {kind === 'research' && <g transform="translate(145 65)"><rect x="5" y="12" width="280" height="355" rx="8" fill="#758e73" transform="rotate(-9 140 190)"/><rect x="180" y="0" width="290" height="360" rx="5" fill="#fffdf4" transform="rotate(8 325 180)"/><g stroke="#9cac99" stroke-width="7" stroke-linecap="round"><path d="M230 90H390M230 120H355M230 215H390M230 248H375M230 280H345"/></g><circle cx="443" cy="292" r="67" fill="#e4ebdf" fill-opacity=".6" stroke="#416453" stroke-width="13"/><path d="M490 340l62 66" stroke="#416453" stroke-width="20" stroke-linecap="round"/><path d="M60 115h78M60 140h55" stroke="#eaf0de" stroke-width="5"/></g>}
  {kind === 'air' && <g fill="none"><rect x="248" y="60" width="255" height="325" rx="125" fill="#f7faf3" stroke="#688b85" stroke-width="6"/><path d="M375 60v325M250 225h253" stroke="#a3bdb5" stroke-width="5"/><g stroke="#6b938b" stroke-width="5"><path d="M92 194C200 125 205 305 390 214S650 150 728 180"/><path d="M80 263C230 188 236 358 417 276S630 230 708 250"/><path d="M100 334C250 280 290 397 453 340S605 304 673 335"/></g><g fill="#aac6b8"><circle cx="156" cy="145" r="13"/><circle cx="571" cy="148" r="20"/><circle cx="634" cy="330" r="15"/></g><g stroke="#4b7166" stroke-width="3"><path d="m552 103 35-30 33 38"/><circle cx="548" cy="104" r="10"/><circle cx="587" cy="73" r="10"/><circle cx="620" cy="111" r="10"/></g></g>}
  {kind === 'home' && <g><path d="M177 228 397 62 624 228v195H177Z" fill="#f9f5e9"/><path d="m140 237 257-190 263 190" fill="none" stroke="#8c9a79" stroke-width="15" stroke-linecap="round"/><rect x="252" y="223" width="110" height="110" fill="#c3d8cf"/><path d="M307 223v110M252 278h110" stroke="#fffdf4" stroke-width="8"/><path d="M437 424V282a48 48 0 0 1 96 0v142" fill="#a3b096"/><circle cx="512" cy="341" r="6" fill="#fffdf4"/><path d="M147 416V321m0 40c-45-3-67-35-61-65 40 4 59 27 61 65m0 20c46-5 70-38 62-66-38 8-60 27-62 66" fill="#799375" stroke="#799375" stroke-width="5"/><path d="M97 417h100l-15 61h-70Z" fill="#b19170"/></g>}
  {kind === 'labels' && <g><rect x="219" y="145" width="163" height="277" rx="30" fill="#8a9d81"/><rect x="257" y="92" width="87" height="70" rx="8" fill="#466650"/><rect x="236" y="236" width="129" height="113" rx="3" fill="#faf7eb"/><path d="M259 262h84M259 287h64M259 312h76" stroke="#a0ab97" stroke-width="5"/><g transform="rotate(10 513 264)"><rect x="425" y="128" width="174" height="258" rx="5" fill="#fffdf6"/><path d="M450 192h122M450 227h95M450 262h112M450 297h79" stroke="#bcae97" stroke-width="6"/><circle cx="512" cy="151" r="7" fill="#e2d9c7"/></g><circle cx="630" cy="352" r="45" fill="#496c5d"/><path d="m610 353 14 14 27-33" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round"/></g>}
  {kind === 'laundry' && <g><rect x="291" y="75" width="317" height="352" rx="20" fill="#fafaf2"/><rect x="308" y="92" width="283" height="52" rx="8" fill="#c1d0d1"/><circle cx="449" cy="276" r="103" fill="#9fb8b8"/><circle cx="449" cy="276" r="81" fill="#dce8e4"/><path d="M375 284q64-67 144 6l-13 50H391Z" fill="#f6f4e8"/><circle cx="553" cy="118" r="12" fill="#5c7b73"/><path d="M328 118h78" stroke="#f7faf7" stroke-width="7"/><rect x="148" y="334" width="140" height="32" rx="10" fill="#a0b094"/><rect x="131" y="369" width="160" height="28" rx="9" fill="#f9f5e9"/><rect x="142" y="400" width="147" height="28" rx="9" fill="#c3b396"/></g>}
