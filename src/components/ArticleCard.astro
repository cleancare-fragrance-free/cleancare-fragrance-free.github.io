---
import ArticleVisual from './ArticleVisual.astro';
import { url } from '../lib/paths';
const { article } = Astro.props;
const titleId = 'article-title-' + article.slug;
const skyBadge = ['air', 'laundry'].includes(article.art);
---
<a class="journal-card" href={url(article.href || 'guides/' + article.slug + '/')}
  data-article-slug={article.slug} data-featured={article.order ? 'true' : undefined} aria-labelledby={titleId}>
  <div class="journal-card-image">
    <div class="journal-card-art" aria-hidden="true">
      {article.photo ? <img src={`${article.photo.src}?auto=compress&cs=tinysrgb&w=800`} srcset={`${article.photo.src}?auto=compress&cs=tinysrgb&w=400 400w, ${article.photo.src}?auto=compress&cs=tinysrgb&w=800 800w`} sizes="(max-width: 700px) 100vw, (max-width: 1050px) 50vw, 33vw" alt="" width="800" height="500" loading="lazy" decoding="async" referrerpolicy="no-referrer" style={{objectPosition: article.photo.position}}/> : <ArticleVisual kind={article.art} label={article.title}/>}
    </div>
    <span class:list={['article-badge', { 'article-badge--sky': skyBadge }]}>{article.topic}</span>
  </div>
  <div class="journal-card-copy">
    <p class="journal-card-meta">{article.sourceName ? `${article.format} · ${article.sourceName}` : `${article.minutes} min read • By ${article.author || 'Clean Care editorial'}`}</p>
    <h3 id={titleId}>{article.title}</h3>
    <p class="journal-card-excerpt">{article.description}</p>
    <span class="journal-card-link">{article.sourceName ? 'Explore the post & source' : 'Read Story'} <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .journal-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }
  .journal-card:is(:hover, :focus-visible) {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(122, 154, 139, 0.12);
  }
  .journal-card-image {
    position: relative;
    height: 220px;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--accent-sky);
  }
  .journal-card-art { width: 100%; height: 100%; }
  .journal-card-art :global(.article-visual),
  .journal-card-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .journal-card:is(:hover, :focus-visible) .journal-card-art :global(.article-visual),
  .journal-card:is(:hover, :focus-visible) .journal-card-image :global(img) {
    transform: scale(1.04);
  }
  .article-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    max-width: calc(100% - 32px);
    border-radius: var(--radius-pill);
    background: var(--accent-sage);
    color: var(--text);
    padding: 8px 13px;
    font-size: 12px;
    line-height: 1.4;
    font-weight: 600;
  }
  .article-badge--sky { background: var(--accent-sky); }
  .journal-card-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 24px;
  }
  .journal-card-meta {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.7;
  }
  .journal-card-meta span { margin-inline: 3px; }
  .journal-card-copy h3 {
    margin: 0 0 14px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.5px;
  }
  .journal-card-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }
  .journal-card-link {
    margin-top: auto;
    color: var(--accent-sage);
    font-size: 14px;
    font-weight: 700;
    transition: color 0.3s ease;
  }
  .journal-card:is(:hover, :focus-visible) .journal-card-link {
    color: var(--accent-active);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .journal-card:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .journal-card, .journal-card-link,
    .journal-card-art :global(.article-visual),
    .journal-card-image :global(img) { transition: none; }
    .journal-card:is(:hover, :focus-visible),
    .journal-card:is(:hover, :focus-visible) .journal-card-art :global(.article-visual),
    .journal-card:is(:hover, :focus-visible) .journal-card-image :global(img) { transform: none; }
  }
</style>
