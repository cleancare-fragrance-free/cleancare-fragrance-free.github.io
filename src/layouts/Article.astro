---
import Layout from './Layout.astro';
import ArticleVisual from '../components/ArticleVisual.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleDisclosure from '../components/ArticleDisclosure.astro';
import { articles } from '../data/articles.mjs';
import { url } from '../lib/paths';
import { articleNextStep } from '../data/guide-topics.mjs';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import PetSafetyVisual from '../components/PetSafetyVisual.astro';
import EnvironmentImpactVisual from '../components/EnvironmentImpactVisual.astro';
const { frontmatter } = Astro.props;
const entry = articles.find(article => article.title === frontmatter.title);
const published = frontmatter.pubDate ? new Date(frontmatter.pubDate) : undefined;
const modified = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : undefined;
const nextStep = articleNextStep(entry?.slug || '');
const sharingImage = entry?.photo ? (entry.photo.provider === 'local' ? url(entry.photo.src) : entry.photo.src) : url('images/editorial/' + (entry?.art === 'air' ? 'home-cleaner-air-habits.webp' : 'home-fragrance-free-swaps.webp'));
const isVideoThumbnail = entry?.photo?.src.includes('i.ytimg.com') || false;
const isVocsLeadImage = entry?.slug === 'identify-and-prevent-vocs';
const isEnvironmentLeadImage = entry?.slug === 'fragrance-and-environment';
const headings = (Astro.props.headings || []).filter(h => h.depth === 2);
const related = articles.filter(article => article !== entry).sort((a,b) => Number(b.topic === entry?.topic) - Number(a.topic === entry?.topic)).slice(0,3);
---
<Layout title={`${frontmatter.title} | CleanCare`} description={frontmatter.description} image={sharingImage} lang={frontmatter.language || 'en'} article={{published:published?.toISOString(),modified:modified?.toISOString()}}>
<header class:list={['container','story-header', {'story-header--video': isVideoThumbnail, 'story-header--vocs': isVocsLeadImage, 'story-header--environment': isEnvironmentLeadImage}]}>
  <div class="story-header-copy">
    <a class="text-link" href={url('guides/')}>← The journal</a>
    <p class="eyebrow">{entry?.topic || frontmatter.topic}</p>
    <h1>{frontmatter.title}</h1>
    <p class="intro">{frontmatter.description}</p>
    <div class="article-meta"><a href={url('about/')}>CleanCare editorial</a>{published && <> · Published <time datetime={published.toISOString().slice(0,10)}>{published.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></>}{modified && <> · Updated <time datetime={modified.toISOString().slice(0,10)}>{modified.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></>}{' · '}{entry?.minutes || 4} min read</div>
    {headings.length > 0 && <details class="article-outline" open><summary>What you’ll learn</summary><ul>{headings.map(heading=><li><a href={'#'+heading.slug}>{heading.text}</a></li>)}</ul></details>}
  </div>
  <figure class:list={['story-cover', {'story-cover--video': isVideoThumbnail, 'story-cover--vocs': isVocsLeadImage, 'story-cover--history': entry?.slug === 'history-of-fragrance', 'story-cover--environment': entry?.slug === 'fragrance-and-environment'}]}>
    {entry?.photo ? <>{entry.photo.sourceUrl ? <a href={entry.photo.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`${isVideoThumbnail ? 'Open video source for' : 'View image source for'} ${frontmatter.title}`}><img src={entry.photo.provider === 'local' ? url(entry.photo.src) : entry.photo.src} alt={entry.photo.alt} width={entry.photo.width || 1200} height={entry.photo.height || 675} decoding="async" referrerpolicy="no-referrer"/></a> : <img src={url(entry.photo.src)} alt={entry.photo.alt} width={entry.photo.width || 1200} height={entry.photo.height || 675} decoding="async"/>}</> : <ArticleVisual kind={entry?.art || 'research'} label={frontmatter.title}/>}
    <figcaption>{entry?.photo ? <>{entry.photo.credit || 'Image from the linked source'}{entry.photo.sourceUrl && <> · <a href={entry.photo.sourceUrl} target="_blank" rel="noopener noreferrer">{isVideoThumbnail ? 'Watch original ↗' : 'View original ↗'}</a></>}</> : 'Original CleanCare illustration'}</figcaption>
  </figure>
</header>
<div class="container story-body"><article class:list={['prose','story-prose', {'history-story': entry?.slug === 'history-of-fragrance'}]}>{entry?.slug === 'history-of-fragrance' && <HistoryTimeline/>}{entry?.slug === 'fragrance-and-pets' && <PetSafetyVisual/>}{entry?.slug === 'fragrance-and-environment' && <EnvironmentImpactVisual/>}<slot/></article><aside class="story-sidebar"><p class="eyebrow">In this story</p>{headings.length > 0 ? <nav aria-label="Article contents">{headings.map(heading => <a href={'#' + heading.slug}>{heading.text}</a>)}</nav> : <p>Read the story, then follow the sources linked throughout.</p>}<hr/><h3>{entry?.slug === 'fragrance-and-pets' ? 'A safer home default.' : entry?.slug === 'fragrance-and-environment' ? 'Make change visible.' : 'Make it personal.'}</h3><p>{entry?.slug === 'fragrance-and-pets' ? 'Choose source control and keep concentrated scent products out of animal reach.' : entry?.slug === 'fragrance-and-environment' ? 'Look for practical changes and transparency actions that fit your community.' : 'Reflect on scented products and the symptoms you notice.'}</p><a class="text-link" href={url(entry?.slug === 'fragrance-and-pets' ? 'non-toxic-home/#house-plan' : entry?.slug === 'fragrance-and-environment' ? 'take-action/' : 'guides/fragrance-free-starter-toolkit/#private-health-check')}>{entry?.slug === 'fragrance-and-pets' ? 'Explore the House Detox plan →' : entry?.slug === 'fragrance-and-environment' ? 'Explore ways to take action →' : 'Try the private health check →'}</a><hr/><a class="text-link" href={url('evidence/')}>Explore the evidence library ↗</a></aside></div>
<section class="container context-next"><p class="eyebrow">From understanding to action</p><h2>Your next practical step</h2><a class="button" href={url(nextStep.path)}>{nextStep.label} →</a></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>A related question, a next step.</h2></div><a class="text-link" href={url('guides/')}>All articles →</a></div><div class="journal-grid">{related.map(article => <ArticleCard article={article}/>)}</div></section>
<section class="container"><ArticleDisclosure scope={entry?.slug === 'fragrance-and-pets' ? 'This article provides general pet-safety education, not veterinary diagnosis or treatment. If an animal is unwell after a suspected exposure, contact a veterinarian or local animal poison service promptly.' : 'This article provides general education, not an individual diagnosis. Follow the linked sources and discuss persistent or concerning symptoms with a healthcare professional.'} imageNote={entry?.photo?.note || (entry?.photo?.generated ? 'Cover image: original AI-generated CleanCare illustration; conceptual artwork, not a photograph of measured environmental effects or an endorsement of depicted products.' : undefined)}>
  {entry?.photo?.licenseUrl && <p>Photograph: <a href={entry.photo.sourceUrl} target="_blank" rel="noopener noreferrer">{entry.photo.credit}</a> · <a href={entry.photo.licenseUrl} target="_blank" rel="noopener noreferrer">{entry.photo.licenseLabel}</a>. Wikimedia’s resized version is displayed; card previews are cropped to fit.</p>}
</ArticleDisclosure></section>
</Layout>
<style>
  /* Keep the supplied photograph at its native size, beside the introduction. */
  .story-header--environment {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 24px 36px;
    align-items: start;
  }
  .story-header--environment .story-header-copy { min-width: 0; }
  .story-header--environment h1 {
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.18;
  }
  .story-cover--environment {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    max-width: 270px;
    margin: 48px 0 24px;
  }
  .story-cover--environment img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 270 / 148;
    object-fit: contain;
    border-radius: 12px;
  }
  .article-outline{margin-top:18px;padding:16px 20px;border:1px solid var(--border);border-radius:16px;background:var(--card);font-size:13px}
  .article-outline summary{font-weight:700;cursor:pointer}
  .article-outline ul{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;margin-bottom:0}
  .article-outline a{color:var(--link-color)}
  @media(max-width:760px) {
    .story-header--environment { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .story-cover--environment { grid-column: 1; grid-row: auto; margin: 16px 0 24px; }
  }
  @media(max-width:700px){.article-outline ul{grid-template-columns:1fr}}
</style>
