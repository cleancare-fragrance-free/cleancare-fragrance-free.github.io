---
import Layout from './Layout.astro';
import ArticleVisual from '../components/ArticleVisual.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles.mjs';
import { url } from '../lib/paths';
import { articleNextStep } from '../data/guide-topics.mjs';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import PetSafetyVisual from '../components/PetSafetyVisual.astro';
import EnvironmentImpactVisual from '../components/EnvironmentImpactVisual.astro';
const { frontmatter } = Astro.props;
const entry = articles.find(article => article.title === frontmatter.title);
const published = frontmatter.pubDate ? new Date(frontmatter.pubDate) : undefined;
const modified = frontmatter.updatedDate ? new Date(frontmatter.updatedDate) : undefined;
const nextStep = articleNextStep(entry?.slug || '');
const sharingImage = entry?.photo ? (entry.photo.provider === 'local' ? url(entry.photo.src) : entry.photo.src) : url('images/editorial/' + (entry?.art === 'air' ? 'home-cleaner-air-habits.webp' : 'home-fragrance-free-swaps.webp'));
const headings = (Astro.props.headings || []).filter(h => h.depth === 2);
const related = articles.filter(article => article !== entry).sort((a,b) => Number(b.topic === entry?.topic) - Number(a.topic === entry?.topic)).slice(0,3);
---
<Layout title={`${frontmatter.title} | CleanCare`} description={frontmatter.description} image={sharingImage} article={{published:published?.toISOString(),modified:modified?.toISOString()}}>
<header class="container story-header"><a class="text-link" href={url('guides/')}>← The journal</a><p class="eyebrow">{entry?.topic || frontmatter.topic}</p><h1>{frontmatter.title}</h1><p class="intro">{frontmatter.description}</p><div class="article-meta"><a href={url('about/')}>CleanCare editorial</a>{published && <> · Published <time datetime={published.toISOString().slice(0,10)}>{published.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></>}{modified && <> · Updated <time datetime={modified.toISOString().slice(0,10)}>{modified.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></>}{' · '}{entry?.minutes || 4} min read</div><p class="editorial-note">AI-assisted educational writing with linked sources; not medically reviewed. <a href={url('about/#editorial-method')}>How this content is prepared →</a></p>{headings.length > 0 && <details class="article-outline" open><summary>What you’ll learn</summary><ul>{headings.map(heading=><li><a href={'#'+heading.slug}>{heading.text}</a></li>)}</ul></details>}<figure class="story-cover">{entry?.photo ? <>{entry.photo.sourceUrl ? <a href={entry.photo.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`View image source for ${frontmatter.title}`}><img src={entry.photo.provider === 'local' ? url(entry.photo.src) : entry.photo.src} alt={entry.photo.alt} width="1200" height="675" decoding="async" referrerpolicy="no-referrer"/></a> : <img src={url(entry.photo.src)} alt={entry.photo.alt} width="1200" height="675" decoding="async"/>}</> : <ArticleVisual kind={entry?.art || 'research'} label={frontmatter.title}/>}<figcaption>{entry?.photo ? <>{entry.photo.credit || 'Image from the linked source'}{entry.photo.sourceUrl && <> · <a href={entry.photo.sourceUrl} target="_blank" rel="noopener noreferrer">View original ↗</a></>}</> : 'Original CleanCare illustration · educational content, not medical advice'}</figcaption></figure></header>
<div class="container story-body"><article class="prose story-prose">{entry?.slug === 'history-of-fragrance' && <HistoryTimeline/>}{entry?.slug === 'fragrance-and-pets' && <PetSafetyVisual/>}{entry?.slug === 'fragrance-and-environment' && <EnvironmentImpactVisual/>}<slot/><aside class="notice">{entry?.slug === 'fragrance-and-pets' ? 'This article provides general pet-safety education, not veterinary diagnosis or treatment. If an animal is unwell after a suspected exposure, contact a veterinarian or local animal poison service promptly.' : 'This article provides general education, not an individual diagnosis. Follow the linked sources and discuss persistent or concerning symptoms with a healthcare professional.'}</aside></article><aside class="story-sidebar"><p class="eyebrow">In this story</p>{headings.length > 0 ? <nav aria-label="Article contents">{headings.map(heading => <a href={'#' + heading.slug}>{heading.text}</a>)}</nav> : <p>Read the story, then follow the sources linked throughout.</p>}<hr/><h3>{entry?.slug === 'fragrance-and-pets' ? 'A safer home default.' : entry?.slug === 'fragrance-and-environment' ? 'Make change visible.' : 'Make it personal.'}</h3><p>{entry?.slug === 'fragrance-and-pets' ? 'Choose source control and keep concentrated scent products out of animal reach.' : entry?.slug === 'fragrance-and-environment' ? 'Look for practical changes and transparency actions that fit your community.' : 'Reflect on scented products and the symptoms you notice.'}</p><a class="text-link" href={url(entry?.slug === 'fragrance-and-pets' ? 'non-toxic-home/#house-plan' : entry?.slug === 'fragrance-and-environment' ? 'take-action/' : 'self-check/')}>{entry?.slug === 'fragrance-and-pets' ? 'Explore the non-toxic home plan →' : entry?.slug === 'fragrance-and-environment' ? 'Explore ways to take action →' : 'Try the self-check →'}</a><hr/><a class="text-link" href={url('evidence/')}>Explore the evidence library ↗</a></aside></div>
<section class="container context-next"><p class="eyebrow">From understanding to action</p><h2>Your next practical step</h2><a class="button" href={url(nextStep.path)}>{nextStep.label} →</a></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>A related question, a next step.</h2></div><a class="text-link" href={url('guides/')}>All articles →</a></div><div class="journal-grid">{related.map(article => <ArticleCard article={article}/>)}</div></section></Layout>
<style>.article-outline{margin-top:18px;padding:16px 20px;border:1px solid var(--border);border-radius:16px;background:var(--card);font-size:13px}.article-outline summary{font-weight:700;cursor:pointer}.article-outline ul{display:grid;grid-template-columns:1fr 1fr;gap:8px 24px;margin-bottom:0}.article-outline a{color:var(--link-color)}@media(max-width:700px){.article-outline ul{grid-template-columns:1fr}}</style>
