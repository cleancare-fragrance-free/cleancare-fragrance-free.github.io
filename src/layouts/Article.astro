---
import Layout from './Layout.astro';
import ArticleVisual from '../components/ArticleVisual.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles.mjs';
import { url } from '../lib/paths';
const { frontmatter } = Astro.props;
const entry = articles.find(article => article.title === frontmatter.title);
const published = frontmatter.pubDate ? new Date(frontmatter.pubDate) : new Date('2026-09-28');
const headings = (Astro.props.headings || []).filter(h => h.depth === 2);
const related = articles.filter(article => article !== entry).sort((a,b) => Number(b.topic === entry?.topic) - Number(a.topic === entry?.topic)).slice(0,3);
---
<Layout title={`${frontmatter.title} | Clean Care`} description={frontmatter.description}>
<header class="container story-header"><a class="text-link" href={url('guides/')}>← The journal</a><p class="eyebrow">{entry?.topic || frontmatter.topic}</p><h1>{frontmatter.title}</h1><p class="intro">{frontmatter.description}</p><div class="article-meta">Clean Care editorial · <time datetime={published.toISOString().slice(0,10)}>{published.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time> · {entry?.minutes || 4} min read</div><figure class="story-cover">{entry?.photo ? <img src={entry.photo.provider === 'local' ? url(entry.photo.src) : entry.photo.src} alt={entry.photo.alt} width="1200" height="675"/> : <ArticleVisual kind={entry?.art || 'research'} label={frontmatter.title}/>}<figcaption>{entry?.photo ? 'Source image or video thumbnail · publisher credited in the article' : 'Original Clean Care illustration · educational content, not medical advice'}</figcaption></figure></header>
<div class="container story-body"><article class="prose story-prose"><slot/><aside class="notice">This article provides general education, not an individual diagnosis. Follow the linked sources and discuss persistent or concerning symptoms with a healthcare professional.</aside></article><aside class="story-sidebar"><p class="eyebrow">In this story</p>{headings.length > 0 ? <nav aria-label="Article contents">{headings.map(heading => <a href={'#' + heading.slug}>{heading.text}</a>)}</nav> : <p>Read the story, then follow the sources linked throughout.</p>}<hr/><h3>Make it personal.</h3><p>Reflect on scented products and the symptoms you notice.</p><a class="text-link" href={url('self-check/')}>Try the self-check →</a><hr/><a class="text-link" href={url('evidence/')}>Explore the evidence library ↗</a></aside></div>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>A related question, a next step.</h2></div><a class="text-link" href={url('guides/')}>All articles →</a></div><div class="journal-grid">{related.map(article => <ArticleCard article={article}/>)}</div></section></Layout>
