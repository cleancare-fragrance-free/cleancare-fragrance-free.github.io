---
import '../styles/global.css';
import '../styles/journal.css';
import '../styles/editorial-theme.css';
import { url } from '../lib/paths';
const { title = 'CleanCare — Understand fragrance exposure', description = 'Evidence-led guides to fragrance exposure, health effects, source documents, and practical fragrance-free alternatives.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#FBF9F6"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/><title>{title}</title>{canonical && <link rel="canonical" href={canonical}/>}<link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
<body><a class="skip-link" href="#main">Skip to content</a>
<div class="announcement">How to live a healthier life and breathe clean air, fragrance free <span>Evidence-led information and practical alternatives.</span></div>
<header class="site-header"><div class="container header-inner"><a class="brand" href={url()} aria-label="CleanCare home"><svg viewBox="0 0 40 44" fill="none" aria-hidden="true"><path d="M20 39V17M20 28C6 27 5 15 5 9c11 1 17 6 15 19Zm0-7C32 19 35 9 33 3 23 5 18 11 20 21ZM25 32h12M28 37h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>CleanCare</a>
<nav aria-label="Main navigation"><a href={url('guides/')}>Articles & Guides</a><a href={url('evidence/')}>Evidence Library</a><a href={url('guides/reduce-fragrance-exposure/')}>Avoiding Exposure</a><a href={url('directory/')}>Fragrance Free Products</a></nav><a class="header-cta" href={url('self-check/')}>Sensitivity self-check <span>↗</span></a></div></header>
<main id="main"><slot/></main>
<footer><div class="container footer-top"><div><a class="brand" href={url()}>CleanCare</a><p>How to live a healthier life and breathe clean air, fragrance free.</p></div><div><a href={url('guides/')}>Articles & Guides</a><a href={url('evidence/')}>Evidence Library</a><a href={url('directory/')}>Fragrance Free Products</a><a href={url('about/')}>Editorial approach</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} CleanCare</span><span>Health information is contextual; individual responses vary.</span><span>Sources linked throughout.</span></div></footer>
</body></html>
